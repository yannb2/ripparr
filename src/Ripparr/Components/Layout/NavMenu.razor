@implements IDisposable
@inject JobEvents Events
@inject JobStore Store
@inject IJSRuntime JS
@inject DiscDrafts Drafts
@inject NavigationManager Navigation

<nav class="sv-sidebar @(_collapsed ? "collapsed" : "") @(MobileOpen ? "sv-mobile-open" : "")">
    <div class="sv-sidebar-header d-none d-md-flex">
        <a href="" class="d-flex align-items-center gap-2 text-decoration-none">
            <img src="favicon.svg" alt="" class="sv-logo"/>
            <span class="text-light fw-semibold sv-logo-text">Ripparr</span>
        </a>
    </div>

    <div class="sv-nav-content">
        <ul class="nav flex-column">
            <li class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="Close">
                    <i class="bi bi-disc"></i>
                    <span>Sources</span>
                </NavLink>
            </li>
            @foreach (var (path, name) in _open)
            {
                <li class="nav-item d-flex align-items-center sv-open-disc" title="@($"{name}\n{path}")">
                    <NavLink class="nav-link py-1 small flex-grow-1 text-truncate" href="@($"disc?Path={Uri.EscapeDataString(path)}")" Match="NavLinkMatch.All" @onclick="Close">
                        <i class="bi bi-disc-fill" style="font-size: .8rem"></i>
                        <span class="text-truncate">@name</span>
                    </NavLink>
                    @if (!_collapsed)
                    {
                        <button class="btn btn-link btn-sm text-secondary p-0 me-2 sv-open-disc-close" title="Take off this list (forgets what was typed on it)" @onclick="() => Forget(path)">
                            <i class="bi bi-x"></i>
                        </button>
                    }
                </li>
            }
            <li class="nav-item">
                <NavLink class="nav-link" href="queue" @onclick="Close">
                    <i class="bi bi-list-task"></i>
                    <span>Queue@(_active > 0 ? $" ({_active})" : "")</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="history" @onclick="Close">
                    <i class="bi bi-clock-history"></i>
                    <span>History</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="extras" @onclick="Close">
                    <i class="bi bi-collection-play"></i>
                    <span>Extras</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="logs" @onclick="Close">
                    <i class="bi bi-journal-text"></i>
                    <span>Logs</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="tools" @onclick="Close">
                    <i class="bi bi-tools"></i>
                    <span>Tools</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="settings" @onclick="Close">
                    <i class="bi bi-gear"></i>
                    <span>Settings</span>
                </NavLink>
            </li>
        </ul>
    </div>

    <div class="sv-sidebar-footer">
        <ul class="nav flex-column w-100">
            <li class="nav-item">
                <button class="nav-link w-100" @onclick="ToggleTheme" title="Switch to @(_dark ? "light" : "dark")">
                    <i class="bi @(_dark ? "bi-moon-fill" : "bi-sun-fill") sv-theme-icon @(_dark ? "" : "light")"></i>
                    <span>@(_dark ? "Dark" : "Light")</span>
                </button>
            </li>
        </ul>
        <div class="d-flex align-items-center justify-content-between sv-footer-meta">
            <span class="d-flex align-items-center gap-2">
                <ConnectionLight/>
                <a href="https://github.com/yannb2/ripparr" target="_blank" rel="noopener"
                   class="sv-version text-decoration-none">v@(AppInfo.Version)</a>
            </span>
            <button class="btn btn-link text-light p-0 sv-footer-btn d-none d-md-inline-flex"
                    @onclick="() => _collapsed = !_collapsed"
                    title="@(_collapsed ? "Expand" : "Collapse")">
                <i class="bi @(_collapsed ? "bi-chevron-right" : "bi-chevron-left")"></i>
            </button>
        </div>
    </div>
</nav>

@if (MobileOpen)
{
    <div class="sv-sidebar-backdrop d-md-none" @onclick="Close"></div>
}

@code {
    [Parameter] public bool MobileOpen { get; set; }
    [Parameter] public EventCallback<bool> MobileOpenChanged { get; set; }

    private bool _collapsed;

    /// <summary>The theme lives in the browser (localStorage); dark until the first render says otherwise.</summary>
    private bool _dark = true;
    private int _active;

    private List<(string Path, string Name)> _open = [];

    protected override void OnInitialized()
    {
        Count();
        _open = Drafts.Recent();
        _recount = new Throttle(TimeSpan.FromSeconds(2), Recount);
        Events.Changed += OnJobChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    // The discs being worked on: a disc page opened (or left) changes the list.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        InvokeAsync(() =>
        {
            _open = Drafts.Recent();
            StateHasChanged();
        });

    private void Forget(string path)
    {
        Drafts.Forget(path);
        _open = Drafts.Recent();
        if (Navigation.Uri.Contains(Uri.EscapeDataString(path), StringComparison.Ordinal))
        {
            Navigation.NavigateTo("");
        }
    }

    private void Count()
    {
        _active = Store.List(200, [JobStatus.Queued, JobStatus.Running]).Count;
    }

    // Progress ticks often: count at most every two seconds, and always after the last change (a
    // job finishing right after its last progress tick), or the menu kept saying "Queue (1)".
    private void OnJobChanged(long id) => _recount?.Poke();

    private Throttle? _recount;

    private void Recount() =>
        InvokeAsync(() =>
        {
            Count();
            StateHasChanged();
        });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dark = await JS.InvokeAsync<string>("ripparrTheme.get") != "light";
            StateHasChanged();
        }
    }

    private async Task ToggleTheme() => _dark = await JS.InvokeAsync<string>("ripparrTheme.toggle") != "light";

    private async Task Close()
    {
        if (MobileOpen)
        {
            await MobileOpenChanged.InvokeAsync(false);
        }
    }

    public void Dispose()
    {
        _recount?.Dispose();
        Events.Changed -= OnJobChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}

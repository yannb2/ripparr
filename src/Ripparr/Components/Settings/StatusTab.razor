@inject IOptions<RipparrOptions> Options
@inject JobStore Store
@inject LiveSettings Live
@using Microsoft.Extensions.Options

<p class="text-body-secondary">
    What Ripparr runs with. Folders and these values come from the environment variables (<code>Ripparr__…</code>)
    and need a restart to change; the other tabs change their settings right away.
</p>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-semibold">Folders</div>
            <table class="table table-sm mb-0 small">
                <tbody>
                @foreach (var (name, path) in Folders)
                {
                    <tr>
                        <td class="text-body-secondary text-nowrap">@name</td>
                        <td class="sv-path">@path</td>
                        <td class="text-end text-nowrap">@Free(path)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-semibold">Settings</div>
            <table class="table table-sm mb-0 small">
                <tbody>
                <tr><td class="text-body-secondary">Jobs at once</td><td>@Options.Value.MaxParallelJobs</td></tr>
                <tr><td class="text-body-secondary">Shortest playlist listed</td><td>@Options.Value.MinPlaylistSeconds s</td></tr>
                <tr><td class="text-body-secondary">Clean the job folder after a good job</td><td>@(Options.Value.CleanWorkFolder ? "yes" : "no")</td></tr>
                <tr><td class="text-body-secondary">Spare space kept</td><td>@Options.Value.SpareSpaceGb GB</td></tr>
                <tr><td class="text-body-secondary">DGDemux arguments (default; a profile can change them)</td><td><code>@Options.Value.DgDemuxArguments</code></td></tr>
                <tr><td class="text-body-secondary">Radarr</td><td>@Arr(Live.Radarr)</td></tr>
                <tr><td class="text-body-secondary">Sonarr</td><td>@Arr(Live.Sonarr)</td></tr>
                <tr><td class="text-body-secondary">ntfy</td><td>@(Live.Notifications.NtfyConfigured ? Live.Notifications.NtfyUrl : "not set up")</td></tr>
                <tr><td class="text-body-secondary">Jobs in the database</td><td>@_jobCount</td></tr>
                <tr><td class="text-body-secondary">Version</td><td>@AppInfo.Version</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private int _jobCount;

    private static string Arr(ArrOptions arr) => arr.Configured ? arr.Url : "not set up";

    protected override void OnInitialized() => _jobCount = Store.List(100000).Count;

    private IEnumerable<(string Name, string Path)> Folders =>
        Options.Value.Sources.Select(s => ($"Source: {s.Name}", s.Path))
            .Append(("Work", Options.Value.WorkFolder))
            .Append(("Done", Options.Value.DoneFolder))
            .Append(("Database", Options.Value.DatabasePath))
            .Append(("Logs", Options.Value.LogFolder))
            .Append(("MakeMKV settings", Options.Value.MakeMkvHome));

    private static string Free(string path)
    {
        try
        {
            var existing = path;
            while (!Directory.Exists(existing) && Path.GetDirectoryName(existing) is { } parent && parent != existing)
            {
                existing = parent;
            }

            var drive = new DriveInfo(existing);
            return $"{Format.Size(drive.AvailableFreeSpace)} free";
        }
        catch (Exception)
        {
            return "";
        }
    }
}

@page "/settings"
@page "/settings/{Tab}"
@page "/profiles"
@page "/status"
@inject NavigationManager Navigation

<PageTitle>Settings · Ripparr</PageTitle>

<h2 class="border-bottom pb-3 mb-3"><i class="bi bi-gear me-2"></i>Settings</h2>

<ul class="nav nav-tabs mb-3">
    @foreach (var (key, label, icon) in Tabs)
    {
        <li class="nav-item">
            <a class="nav-link @(_tab == key ? "active" : "")" href="settings/@key">
                <i class="bi @icon me-1"></i>@label
            </a>
        </li>
    }
</ul>

@switch (_tab)
{
    case "integrations":
        <IntegrationsTab/>
        break;
    case "notifications":
        <NotificationsTab/>
        break;
    case "status":
        <StatusTab/>
        break;
    default:
        <ProfilesTab/>
        break;
}

@code {
    [Parameter] public string? Tab { get; set; }

    private string _tab = "profiles";

    /// <summary>The tabs, in order. A new kind of setting gets its own tab here.</summary>
    public static readonly (string Key, string Label, string Icon)[] Tabs =
    [
        ("profiles", "Profiles", "bi-sliders"),
        ("integrations", "Integrations", "bi-plug"),
        ("notifications", "Notifications", "bi-bell"),
        ("status", "Status", "bi-info-circle")
    ];

    protected override void OnParametersSet()
    {
        // The old /profiles and /status pages open their tab.
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        var wanted = Tab ?? (path == "status" ? "status" : "profiles");
        _tab = Tabs.Any(t => t.Key == wanted) ? wanted : "profiles";
    }
}

@page "/disc"
@inject DiscAnalyzer Analyzer
@inject DiscDrafts Drafts
@inject StreamProbe Probe
@inject SubtitleScanner Scanner
@inject PlaylistFinder Finder
@inject JobStore Store
@inject JobRunner Runner
@inject RadarrClient Radarr
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Options.IOptions<RipparrOptions> Options
@implements IDisposable

<PageTitle>@(_source?.Name ?? "Disc") · Ripparr</PageTitle>

<div class="mb-2"><a href="" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Sources</a></div>

@if (_source == null)
{
    <div class="alert alert-warning">This is not an ISO file or a folder with a BDMV folder: <code>@Path</code></div>
    return;
}

<h2 class="sv-file-name mb-1">@_source.Name</h2>
<div class="sv-path text-body-secondary mb-3">@_source.Path</div>

@if (_analysis == null)
{
    <div class="text-body-secondary"><span class="spinner-border spinner-border-sm me-2"></span>Reading the playlists…</div>
    return;
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <span class="badge text-bg-secondary">@(_source.Kind == SourceKind.Iso ? "ISO" : "BDMV folder")</span>
    <span class="badge text-bg-secondary">@Format.Size(_source.Size)</span>
    @switch (_analysis.Encryption)
    {
        case Encryption.None:
            <span class="badge text-bg-success">Not encrypted</span>
            @if (_source.Kind == SourceKind.Iso && _mount != null)
            {
                @if (_mount.Ok)
                {
                    <span class="badge text-bg-success" title="The mount service mounts the ISO read-only for the job: nothing is copied.">
                        <i class="bi bi-hdd"></i> Mount service ready: read in place
                    </span>
                }
                else
                {
                    <span class="badge text-bg-warning" title="@_mount.Error">
                        <i class="bi bi-exclamation-triangle"></i> Mount service not reachable: the job will @(Options.Value.IsoMount.WhenItFails == MountFallback.Ask ? "ask before unpacking" : "unpack it")
                    </span>
                }
            }
            break;
        case Encryption.Encrypted:
            <span class="badge text-bg-warning" title="MakeMKV decrypts a copy first.">Encrypted: MakeMKV decrypts it first</span>
            break;
        case Encryption.Likely:
            <span class="badge text-bg-warning" title="The ISO has an AACS folder.">AACS folder: MakeMKV decrypts it first</span>
            break;
        default:
            <span class="badge text-bg-secondary">Encryption unknown</span>
            break;
    }
    @if (!string.IsNullOrEmpty(_analysis.DiscTitle))
    {
        <span class="badge text-bg-light">Disc title: @_analysis.DiscTitle</span>
    }
    <button class="btn btn-sm btn-link p-0 ms-auto" @onclick="StartOver" title="Puts back the title, tracks, tags and extras as on a first visit (your edits are kept while you go to other pages)"><i class="bi bi-eraser"></i> Start over</button>
    <button class="btn btn-sm btn-link p-0 ms-3" @onclick="Reload"><i class="bi bi-arrow-clockwise"></i> Read again</button>
</div>

@if (_analysis.Error != null)
{
    <div class="alert alert-danger">@_analysis.Error</div>
}

@foreach (var note in _analysis.Notes)
{
    <div class="alert alert-secondary py-2 small">@note</div>
}

@if (_analysis.Playlists.Where(p => p.FromClip != null).ToList() is { Count: > 0 } madeFromClips)
{
    <div class="alert alert-info py-2 small">
        No playlist on this disc plays @string.Join(", ", madeFromClips.Select(p => $"{p.FromClip}.m2ts ({Format.Size(p.Size)})")):
        the disc's menu builds that playlist when it plays. Ripparr made one for each from the clip's CLIPINF file, with all its
        streams and languages, listed as "Clip". It has no chapters: those are in the playlist the menu builds.
    </div>
}

@* On a TV disc the fakes are left out of the episodes already: nothing to find. *@
@if (_analysis.NeedsFinding && !_tv)
{
    <div class="alert alert-warning py-2 small">
        <div class="mb-1">
            @if (_analysis.Playlists.Count(p => p.Lookalike) is var lookalikes && lookalikes > 0 && (_analysis.HidesFilm || _analysis.ManyPlaylists))
            {
                <span>
                    @_analysis.Playlists.Count(p => p.Lookalike) playlists have nearly the film's length and use its clips in other
                    orders: this disc hides the real one among fakes.
                </span>
            }
            @if (_analysis.FilmMissing)
            {
                <span>
                    The playlist taken as the film holds @Format.Size(_analysis.MainFeature!.Size) of this disc's @Format.Size(_analysis.ClipBytes):
                    the real film's playlist is missing or hidden (some discs build it at play time in their Java menu).
                    Ask MakeMKV: with Java it plays the menu and names it.
                </span>
            }
            @if (_analysis.Playlists.Any(p => p.LengthLooksFaked))
            {
                <span>
                    @_analysis.Playlists.Count(p => p.LengthLooksFaked) playlist(s) hold far more data than their length allows:
                    their times are faked, so they are listed even though they claim to be short.
                </span>
            }
            @if (_analysis.Playlists.Any(p => p.TooLittleData))
            {
                <span>
                    @_analysis.Playlists.Count(p => p.TooLittleData) long playlist(s) hold far too little data for their length
                    (they loop tiny clips) and are not taken as the film.
                </span>
            }
        </div>
        @if (_analysis.NeedsFinding)
        {
            <div class="d-flex flex-wrap align-items-center gap-2">
                <button class="btn btn-sm btn-light border" disabled="@_finding" @onclick="CheckJoins"
                        title="Compares the last picture of each clip with the first of the next: the film's clips join seamlessly, a fake's jump.">
                    <i class="bi bi-puzzle me-1"></i>Check clip joins
                </button>
                <button class="btn btn-sm btn-light border" disabled="@_finding" @onclick="AskMakeMkv"
                        title="MakeMKV plays the disc's menus (BD-J too) and names the main feature. Takes a minute or two.">
                    <i class="bi bi-question-circle me-1"></i>Ask MakeMKV
                </button>
                @if (_finding)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                    <span>@_findStatus</span>
                }
                else if (_findStatus != null)
                {
                    <span>@_findStatus</span>
                }
            </div>
        }
    </div>
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <span class="small text-body-secondary">This disc holds</span>
    <div class="btn-group btn-group-sm" role="group" aria-label="Film or TV episodes">
        <button class="btn @(_tv ? "btn-outline-secondary" : "btn-secondary")" @onclick="() => _tv = false"><i class="bi bi-film"></i> A film</button>
        <button class="btn @(_tv ? "btn-secondary" : "btn-outline-secondary")" @onclick="() => _tv = true"><i class="bi bi-tv"></i> TV episodes</button>
    </div>
    @if (_tvGuess)
    {
        <span class="small text-body-secondary">@_episodeCount playlists of about the same length: looks like a TV disc.</span>
    }
</div>

@if (_tv)
{
    <EpisodesPicker Source="_source" Analysis="_analysis" Profiles="_profiles" InitialSearch="@ReleaseName.Guess(_source.Name).Title" CanListen="CanListen" State="_draft!.Episodes"/>
}

<div class="card mb-3">
    <div class="card-header d-flex align-items-center">
        <span class="fw-semibold me-auto">Playlists</span>
        <div class="form-check form-switch mb-0 small">
            <input class="form-check-input" type="checkbox" id="showAll" @bind="_showAll"/>
            <label class="form-check-label" for="showAll">Show short and duplicate ones</label>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead>
            <tr>
                <th></th>
                <th>Playlist</th>
                <th>Length</th>
                <th class="text-end">Chapters</th>
                <th class="text-end">Clips</th>
                <th class="text-end">Size</th>
                <th>Video</th>
                <th>Audio</th>
                <th>Subtitles</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var playlist in VisiblePlaylists)
            {
                var streams = playlist.Mpls.Streams;
                <tr class="sv-clickable-row @(_selected == playlist ? "table-active" : "")" @onclick="() => Select(playlist)">
                    <td><input type="radio" class="form-check-input" checked="@(_selected == playlist)"/></td>
                    <td class="fw-semibold">@playlist.Label</td>
                    <td class="text-nowrap">@Format.Duration(playlist.Duration)</td>
                    <td class="text-end">@playlist.Mpls.Chapters.Count</td>
                    <td class="text-end" title="@string.Join(", ", playlist.Mpls.Clips)">@playlist.Mpls.Clips.Count</td>
                    <td class="text-end text-nowrap">@Format.Size(playlist.Size)</td>
                    <td class="text-nowrap">
                        @string.Join(" ", streams.Where(s => s.Kind == StreamKind.Video && !s.DolbyVisionEnhancementLayer).Take(1).Select(s => $"{StreamCoding.Resolution(s.Format)} {s.CodecName}"))
                        @if (playlist.Mpls.HasDolbyVisionEnhancementLayer)
                        {
                            <span class="badge sv-dv ms-1">DV EL</span>
                        }
                    </td>
                    <td>@string.Join(", ", streams.Where(s => s.Kind == StreamKind.Audio).Select(s => $"{Languages.Name(s.Language)} {s.CodecName}"))</td>
                    <td>@string.Join(", ", streams.Where(s => s.Kind == StreamKind.Subtitle).Select(s => Languages.Name(s.Language)).Distinct())</td>
                    <td class="text-nowrap">
                        @if (playlist.MainFeature)
                        {
                            <span class="badge text-bg-success" title="@(playlist.MainReason ?? "The longest playlist, then the one with most chapters.")">Main feature</span>
                        }
                        @if (playlist.TooLittleData)
                        {
                            <span class="badge text-bg-danger" title="@($"{playlist.BitsPerSecond / 1_000_000:0.0} Mbit/s: a film runs at 10 or more. It loops tiny clips.")">Too little data</span>
                        }
                        @if (playlist.FromClip != null)
                        {
                            <span class="badge text-bg-info" title="@($"No playlist on the disc plays {playlist.FromClip}.m2ts (the disc's menu builds it at play time). Ripparr made one from {playlist.FromClip}.clpi: all its streams, no chapters.")">No playlist</span>
                        }
                        @if (playlist.LengthLooksFaked)
                        {
                            <span class="badge text-bg-warning" title="@($"{Format.Size(playlist.Size)} in a playlist that claims {playlist.Duration:h\\:mm\\:ss}: more than any Blu-ray can play. Its times are faked.")">Faked length</span>
                        }
                        @if (playlist.Lookalike && !playlist.MainFeature)
                        {
                            <span class="badge text-bg-warning" title="Near the film's length, made of its clips in another order: a fake, or the film.">Lookalike</span>
                        }
                        @if (playlist.JoinScore is { } joins)
                        {
                            <span class="badge @(playlist.Name == _analysis.JoinPick ? "text-bg-success" : "text-bg-light border")"
                                  title="Mean picture change at its clip joins (0 = seamless). The film's is the lowest.">Joins @joins.ToString("0.0")</span>
                        }
                        @if (playlist.Name == _analysis.MakeMkvPick)
                        {
                            <span class="badge text-bg-success" title="MakeMKV names this title the main feature.">MakeMKV</span>
                        }
                        @if (playlist.Lookalike && playlist.UniqueClips > 0)
                        {
                            <span class="badge text-bg-light border" title="Clips no other long playlist uses: the film's own scenes are often among them.">@playlist.UniqueClips own clip(s)</span>
                        }
                        @if (playlist.PossibleCut)
                        {
                            <span class="badge text-bg-info" title="Long and shares most clips with the main feature: probably another cut.">Other cut?</span>
                        }
                        @if (playlist.DuplicateOf != null)
                        {
                            <span class="badge text-bg-secondary">Same as @playlist.DuplicateOf</span>
                        }
                        @if (playlist.Short)
                        {
                            <span class="badge text-bg-secondary">Short</span>
                        }
                        <button type="button" class="btn btn-sm btn-link p-0 ms-1 text-nowrap align-baseline" @onclick:stopPropagation="true"
                                @onclick="() => ToggleWatch(playlist)" title="30 seconds of the playlist as a small video: start, middle or end">
                            <i class="bi @(_watching.Contains(playlist.Name) ? "bi-play-circle-fill" : "bi-play-circle")"></i> Watch
                        </button>
                    </td>
                </tr>
                @if (_watching.Contains(playlist.Name))
                {
                    <tr>
                        <td></td>
                        <td colspan="8"><WatchPanel SourcePath="@_source.Path" Playlist="@playlist.Name"/></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@if (!_tv && _selected != null && _plan != null)
{
    <div class="card mb-3">
        <div class="card-header fw-semibold">New job: @(_selected.FromClip == null ? $"playlist {_selected.Name}" : $"clip {_selected.FromClip}")</div>
        <div class="card-body">
            <div class="row g-2 align-items-end mb-3">
                <div class="col-md-6">
                    <label class="form-label small mb-1">Look up in Radarr</label>
                    <div class="input-group input-group-sm">
                        <input class="form-control" @bind="_search" @onkeyup="SearchOnEnter"/>
                        <button class="btn btn-outline-secondary" @onclick="Search" disabled="@(!Radarr.Configured || _searching)">
                            @if (_searching)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <i class="bi bi-search"></i>
                            }
                        </button>
                    </div>
                    @if (!Radarr.Configured)
                    {
                        <div class="form-text">Radarr is not set up: fill in the title, year and IDs by hand.</div>
                    }
                </div>
                <div class="col-md-6">
                    <label class="form-label small mb-1">Profile</label>
                    <select class="form-select form-select-sm" value="@_profileId" @onchange="ChangeProfile">
                        @foreach (var profile in _profiles)
                        {
                            <option value="@profile.Id">@profile.Name</option>
                        }
                    </select>
                </div>
            </div>

            @if (_searchError != null)
            {
                <div class="alert alert-warning py-2 small">@_searchError</div>
            }

            @if (_matches.Count > 0)
            {
                <div class="list-group list-group-flush mb-3 small">
                    @foreach (var match in _matches.Take(8))
                    {
                        <div class="list-group-item list-group-item-action d-flex align-items-center gap-2">
                            <button class="btn btn-link p-0 text-reset text-decoration-none text-start flex-grow-1 small" @onclick="() => Pick(match)">
                                <span class="fw-semibold">@match.Title (@match.Year)</span>
                                <span class="text-body-secondary ms-2">TMDb @match.TmdbId · @match.ImdbId · @Languages.Name(match.OriginalLanguage)</span>
                                @if (match.LibraryPath != null)
                                {
                                    <span class="badge text-bg-success ms-2">In Radarr</span>
                                }
                            </button>
                            @if (match.LibraryPath == null)
                            {
                                <button class="btn btn-sm btn-outline-secondary py-0 text-nowrap" @onclick="() => _adding = _adding == match ? null : match"
                                        title="Adds the film to Radarr (unmonitored, no search) for the manual import">
                                    <i class="bi bi-plus-lg"></i> Add to Radarr
                                </button>
                            }
                        </div>
                        @if (_adding == match)
                        {
                            <ArrAddForm App="Radarr" LoadOptions="Radarr.AddOptionsAsync" AddIt="(root, profile, _) => AddToRadarr(match, root, profile)"
                                        Animation="match.Animation" Anime="@(match.Animation && match.OriginalLanguage == "jpn")"
                                        Cancelled="() => _adding = null"/>
                        }
                    }
                </div>
            }

            <div class="row g-2 mb-3">
                <div class="col-md-3">
                    <label class="form-label small mb-1">Title</label>
                    <input class="form-control form-control-sm" @bind="_title" @bind:event="oninput"/>
                </div>
                <div class="col-md-1">
                    <label class="form-label small mb-1">Year</label>
                    <input class="form-control form-control-sm" type="number" @bind="_year" @bind:event="oninput"/>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1">Edition</label>
                    <input class="form-control form-control-sm" placeholder="@(_selected.PossibleCut ? "another cut?" : "")" @bind="_edition" @bind:event="oninput"/>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1" title="Who put out the disc, such as Criterion or Arrow (not the cut: that is the edition). Written as the MKV tag LABEL.">Release label</label>
                    <input class="form-control form-control-sm" list="release-labels" placeholder="Criterion, Arrow..." @bind="_label" @bind:event="oninput"/>
                    <datalist id="release-labels">
                        @foreach (var label in ReleaseLabels)
                        {
                            <option value="@label"></option>
                        }
                    </datalist>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1" title="Where the disc came from: who released the ISO (FraMeSToR...), read from its name, or Own disc. Written as the MKV tag SOURCE_RELEASE_GROUP; empty counts as Own disc. Your own group is the RELEASE_GROUP tag.">Source group</label>
                    <input class="form-control form-control-sm" list="source-groups" placeholder="@Job.OwnDisc" @bind="_sourceGroup" @bind:event="oninput"/>
                    <datalist id="source-groups"><option value="@Job.OwnDisc"></option></datalist>
                </div>
                <div class="col-md-1">
                    <label class="form-label small mb-1" title="Only when two releases of the film differ by country (a better GBR or DEU disc): three letters, such as GBR. Written as the MKV tag DISC_COUNTRY and as [GBR] after the source in the file name. Read from the ISO name when it has one.">Country</label>
                    <input class="form-control form-control-sm" list="countries" maxlength="3" placeholder="GBR..." @bind="_country" @bind:event="oninput"/>
                </div>
                <datalist id="countries">
                    @foreach (var country in ReleaseName.Countries)
                    {
                        <option value="@country"></option>
                    }
                </datalist>
                <div class="col-md-1">
                    <label class="form-label small mb-1">TMDb ID</label>
                    <input class="form-control form-control-sm" type="number" @bind="_tmdb"/>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1">IMDb ID</label>
                    <input class="form-control form-control-sm" @bind="_imdb"/>
                </div>
                <div class="col-md-1">
                    <label class="form-label small mb-1" title="ISO 639-2, such as eng or fre">Language</label>
                    <input class="form-control form-control-sm" value="@_original" @onchange="ChangeOriginal" title="The film's original language: decides 'original' in the profile"/>
                    <div class="small text-body-secondary text-truncate">@(_original == null ? "" : Languages.Name(_original))</div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 small mb-2">
                @if (_probing)
                {
                    <span class="spinner-border spinner-border-sm text-secondary"></span>
                    <span class="text-body-secondary">Reading the streams of @(_selected.FromClip == null ? $"playlist {_selected.Name}" : $"clip {_selected.FromClip}")…</span>
                }
                else if (_probe is { Error: { } probeError })
                {
                    <i class="bi bi-info-circle text-body-secondary"></i>
                    <span class="text-body-secondary">@probeError</span>
                    <button class="btn btn-sm btn-link p-0" @onclick="ReadStreams">Try again</button>
                }
                else if (_probe != null)
                {
                    <i class="bi bi-check2 text-success"></i>
                    <span class="text-body-secondary">
                        Streams read in @_probe.Took.TotalSeconds.ToString("0.#") s@(_probe.Estimated ? "; bit rates and sizes are estimated from the start of the film" : "").
                    </span>
                }
            </div>

            @if (_selected.Mpls.Streams.Any(s => s.Kind == StreamKind.Subtitle))
            {
                <div class="d-flex flex-wrap align-items-center gap-2 small mb-2">
                    @if (_subtitles is { Running: true } running)
                    {
                        <span class="spinner-border spinner-border-sm text-secondary"></span>
                        <span class="text-body-secondary">@running.Stage, @((running.Progress * 100).ToString("0"))%…</span>
                        <div class="progress flex-grow-1" style="height: 6px; max-width: 20rem">
                            <div class="progress-bar" style="width: @((running.Progress * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        </div>
                    }
                    else if (_subtitles is { Error: { } subtitleError })
                    {
                        <i class="bi bi-info-circle text-body-secondary"></i>
                        <span class="text-body-secondary">@subtitleError</span>
                        <button class="btn btn-sm btn-link p-0" @onclick="() => ReadSubtitles(_subtitles.Quick)">Try again</button>
                    }
                    else if (_subtitles != null)
                    {
                        <span class="w-100 order-last d-flex flex-wrap align-items-center gap-2 mt-1">
                            @if (_compare.Count >= 2)
                            {
                                <a class="btn btn-sm btn-outline-secondary" target="_blank"
                                   href="@($"discs/{_subtitles.Key}/compare?pids={string.Join(',', _subtitles.Tracks.Keys.Where(_compare.Contains))}")">
                                    <i class="bi bi-layout-three-columns"></i> Side by side (@_compare.Count tracks)
                                </a>
                                <button class="btn btn-sm btn-link p-0" @onclick="() => _compare.Clear()">clear</button>
                            }
                            else
                            {
                                <span class="text-body-secondary">Compare: tick <i class="bi bi-layout-three-columns"></i> compare on two or more subtitle tracks below, then open Side by side</span>
                            }
                        </span>
                        <i class="bi bi-check2 text-success"></i>
                        <span class="text-body-secondary">
                            @if (_subtitles.Quick)
                            {
                                @($"Checked in {(_subtitles.Took.TotalSeconds < 60 ? $"{_subtitles.Took.TotalSeconds:0.#} s" : Format.Duration(_subtitles.Took))}, on {_subtitles.QuickNote}: ")
                                <span>caption counts from that sample only@(SubtitleFlagsNote).</span>
                            }
                            else
                            {
                                @(_subtitles.FullText ? "Subtitles read" : "Subtitles previewed") @(" in " + (_subtitles.Took.TotalSeconds < 60 ? $"{_subtitles.Took.TotalSeconds:0.#} s" : Format.Duration(_subtitles.Took)) + ":")
                                <span>caption counts and <i class="bi bi-eye"></i> previews below@(SubtitleFlagsNote).</span>
                            }
                        </span>
                        @if (_subtitles.Stage.StartsWith("The OCR failed", StringComparison.Ordinal))
                        {
                            <span class="text-danger">@_subtitles.Stage</span>
                        }
                        @if (_subtitles.Quick)
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ReadSubtitles(false)"
                                    title="Reads the whole film once (minutes for a UHD disc): exact caption counts, forced captions and every caption in the preview">
                                <i class="bi bi-badge-cc"></i> Preview subtitles (whole film)
                            </button>
                        }
                        else if (!_subtitles.FullText)
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ReadAllText"
                                    title="Tesseract reads every caption of every track: SDH and commentary checked on all of them, and the text shows in the preview and compare pages. A few minutes per track.">
                                <i class="bi bi-fonts"></i> Read subtitles
                            </button>
                        }
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ReadSubtitles(true)"
                                title="Reads a few slices spread over the film (seconds on a folder or a mounted ISO) and checks a sample of each track's captions for SDH and commentary text">
                            <i class="bi bi-search"></i> Check SDH and commentary
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ReadSubtitles(false)"
                                title="Reads the whole film once (minutes for a UHD disc) for each subtitle track's exact caption count, forced captions, a preview and the SDH / commentary check">
                            <i class="bi bi-badge-cc"></i> Preview subtitles
                        </button>
                        <span class="text-body-secondary">The check takes seconds; the preview reads the whole film for exact counts and forced captions.</span>
                    }
                </div>
            }

            <TrackPlanEditor Plan="_plan" Probe="@(_probe is { Error: null } ? _probe : null)" Subtitles="_subtitles" ListenUrl="@(CanListen ? ListenUrl : null)"
                             Compare="@(_subtitles is { Running: false, Error: null } ? _compare : null)" CompareChanged="ToggleCompare"/>

            <ChapterList Playlist="_selected.Mpls" Naming="Profile.Chapters" Names="_chapterNames"/>

            @if (Profile.WriteTags)
            {
                <div class="mt-3">
                    <div class="small fw-semibold mb-1"><i class="bi bi-tags me-1"></i>Global tags</div>
                    <GlobalTagEditor Tags="_tags" Placeholder="empty = not written" Changed="StateHasChanged"/>
                    <div class="form-text">
                        From the profile, for this disc. TMDB, IMDB, SOURCE, RELEASE_NAME, SOURCE_RELEASE_GROUP, DISC_TITLE, EDITION, LABEL (the release label), HDR_FORMAT and the other automatic tags
                        are written too; a tag here with the same name replaces the automatic one.
                    </div>
                </div>
            }

            <div class="mt-3 small">
                <div><span class="text-body-secondary">MKV title:</span> <span class="fw-semibold">@PreviewTitle</span></div>
                <div><span class="text-body-secondary">File name (expected; codec and HDR words come from the streams):</span> <span class="sv-path">@PreviewFile</span></div>
            </div>

            @if (_error != null)
            {
                <div class="alert alert-danger py-2 small mt-3">@_error</div>
            }

            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-primary" @onclick="() => Queue(false)"><i class="bi bi-play-fill"></i> Queue the job</button>
                <button class="btn btn-outline-secondary" @onclick="() => Queue(true)" title="Prints the commands without running the long steps">Dry run</button>
            </div>
        </div>
    </div>
}

@if (!_tv && _selected != null && _plan != null)
{
    <ExtrasPicker Source="_source" Analysis="_analysis" Profiles="_profiles" FilmPlaylist="_selected" FilmJob="FilmJob" State="_draft!.Extras" CanListen="CanListen"/>
}

@code {
    [SupplyParameterFromQuery] public string? Path { get; set; }

    private DiscSource? _source;
    private DiscAnalysis? _analysis;
    private PlaylistInfo? _selected;

    /// <summary>
    /// ffmpeg cuts a sample from a plain folder, or a plain ISO the mount service mounts: it has to
    /// seek, and cannot read an encrypted stream.
    /// </summary>
    private bool CanListen => _analysis is { Encryption: not Encryption.Encrypted }
                              && (_source!.Kind != SourceKind.Iso || _mount is { Ok: true });

    private string ListenUrl(PlannedTrack track) =>
        $"api/discs/listen/{track.Pid}.m4a?path={Uri.EscapeDataString(_source!.Path)}&playlist={Uri.EscapeDataString(_selected!.Name)}";
    private TrackPlan? _plan;
    private bool _showAll;
    private readonly HashSet<string> _watching = [];

    private void ToggleWatch(PlaylistInfo playlist)
    {
        if (!_watching.Remove(playlist.Name))
        {
            _watching.Add(playlist.Name);
        }
    }
    private bool _tv;
    private bool _tvGuess;
    private int _episodeCount;
    private List<RipProfile> _profiles = [];
    private string _profileId = "";

    private string _search = "";
    private bool _searching;
    private string? _searchError;
    private List<MovieMatch> _matches = [];

    private string _title = "";
    private int? _year;
    private string? _edition;
    private string? _label;
    private string? _sourceGroup;
    private string? _country;

    /// <summary>Boutique labels offered in the Release label box (any other name can be typed).</summary>
    private static readonly string[] ReleaseLabels =
    [
        "Criterion", "Arrow", "Kino Lorber", "Shout! Factory", "Scream Factory", "Eureka", "Indicator", "BFI",
        "Second Sight", "88 Films", "Vinegar Syndrome", "Severin", "Umbrella", "Imprint", "Radiance", "Masters of Cinema"
    ];
    private int? _tmdb;
    private string? _imdb;
    private string? _original;
    private string? _error;

    private IEnumerable<PlaylistInfo> VisiblePlaylists => (_showAll
            ? _analysis!.Playlists
            : _analysis!.Playlists.Where(p => !p.Short && p.DuplicateOf == null))
        .OrderByDescending(p => p.MainFeature)
        .ThenByDescending(p => p.Duration);

    private RipProfile Profile => _profiles.FirstOrDefault(p => p.Id == _profileId) ?? _profiles.FirstOrDefault() ?? new RipProfile();

    protected override async Task OnParametersSetAsync()
    {
        _source = string.IsNullOrEmpty(Path) ? null : Analyzer.Describe(Path);
        if (_source == null)
        {
            return;
        }

        _profiles = Store.Profiles();
        _draft = Drafts.Get(_source.Path);
        _draft.Name = _source.Name;
        if (_draft.Saved)
        {
            _title = _draft.Title;
            _year = _draft.Year;
            _edition = _draft.Edition;
            _label = _draft.Label;
            _sourceGroup = _draft.SourceGroup;
            _country = _draft.Country;
            _tmdb = _draft.Tmdb;
            _imdb = _draft.Imdb;
            _original = _draft.Original;
            _search = _draft.Search;
            _showAll = _draft.ShowAll;
        }
        else
        {
            Guess();
        }

        await Load(false);
    }

    private void Guess()
    {
        var guess = ReleaseName.Guess(_source!.Name);
        _title = guess.Title;
        _year = guess.Year;
        _edition = null;
        _label = null;
        _sourceGroup = ReleaseName.Group(_source.Name) ?? Job.OwnDisc;
        _country = ReleaseName.Country(_source.Name);
        _tmdb = null;
        _imdb = null;
        _original = null;
        _matches = [];
        _search = guess.Year is { } y ? $"{guess.Title} {y}" : guess.Title;
    }

    /// <summary>The page's edits, kept while you go to other pages (subtitle preview, a job, the menu).</summary>
    private DiscDraft? _draft;

    /// <summary>Saves the form into the disc's draft after each change.</summary>
    protected override void OnAfterRender(bool firstRender)
    {
        if (_draft == null || _analysis == null || _selected == null || _plan == null)
        {
            return;
        }

        _draft.Playlist = _selected.Name;
        _draft.Tv = _tv;
        _draft.ShowAll = _showAll;
        _draft.Search = _search;
        _draft.Title = _title;
        _draft.Year = _year;
        _draft.Edition = _edition;
        _draft.Label = _label;
        _draft.SourceGroup = _sourceGroup;
        _draft.Country = _country;
        _draft.Tmdb = _tmdb;
        _draft.Imdb = _imdb;
        _draft.Original = _original;
        _draft.Touched = DateTime.UtcNow;
        _draft.Playlists[_selected.Name] = new PlaylistDraft
        {
            Plan = _plan, ProfileId = _profileId, Tags = _tags, Compare = _compare, Flagged = _flagged, Auto = _auto,
            ChapterNames = _chapterNames
        };
    }

    /// <summary>"Read again": the disc read anew, so each playlist's tracks are planned anew too.</summary>
    private async Task Reload()
    {
        _draft?.Playlists.Clear();
        await Load(true);
    }

    private async Task StartOver()
    {
        _draft = Drafts.Reset(_source!.Path);
        _tags = [];
        _compare = [];
        _showAll = false;
        Guess();
        await Load(false);
    }

    /// <summary>The mount service's answer to a ping, for plain ISOs (null: not asked, or switched off).</summary>
    private MountReply? _mount;

    private async Task Load(bool fresh)
    {
        _analysis = null;
        StateHasChanged();
        _analysis = await Analyzer.AnalyseAsync(_source!, CancellationToken.None, fresh);
        _mount = _source!.Kind == SourceKind.Iso && Options.Value.IsoMount.Enabled
            ? await IsoMount.PingAsync(Options.Value.IsoMount.Socket, CancellationToken.None)
            : null;
        _tvGuess = EpisodeFinder.LooksLikeTv(_analysis);
        _episodeCount = EpisodeFinder.Find(_analysis).Count;
        _tv = _draft?.Tv ?? _tvGuess;
        if (_draft?.Playlist is { } name && _analysis.Playlists.FirstOrDefault(p => p.Name == name) is { } kept)
        {
            Select(kept);
        }
        else if (_analysis.MainFeature is { } main)
        {
            Select(main);
        }
    }

    private bool _finding;
    private string? _findStatus;

    private async Task CheckJoins() => await Find(() => Finder.CheckJoinsAsync(_analysis!, status =>
    {
        _findStatus = status;
        InvokeAsync(StateHasChanged);
    }, CancellationToken.None));

    private async Task AskMakeMkv()
    {
        _findStatus = "MakeMKV is reading the disc and its menus...";
        await Find(() => Finder.AskMakeMkvAsync(_analysis!, CancellationToken.None));
    }

    private async Task Find(Func<Task<string>> work)
    {
        _finding = true;
        StateHasChanged();
        try
        {
            _findStatus = await work();
            if (_analysis!.MainFeature is { } main && main != _selected)
            {
                Select(main);
            }
        }
        catch (Exception e) when (e is IOException or InvalidOperationException)
        {
            _findStatus = e.Message;
        }
        finally
        {
            _finding = false;
            StateHasChanged();
        }
    }

    private ProbeResult? _probe;
    private bool _probing;
    private CancellationTokenSource? _probeCancel;

    private void Select(PlaylistInfo playlist)
    {
        _selected = playlist;
        _probe = Probe.Cached(_source!, playlist);
        _subtitles = Scanner.Find(_source!, playlist);
        WatchSubtitles();
        // Back on a playlist already edited: its tracks, profile and tags as they were left.
        if (_draft != null && _draft.Playlists.TryGetValue(playlist.Name, out var kept) && _profiles.Any(p => p.Id == kept.ProfileId))
        {
            _profileId = kept.ProfileId;
            _plan = kept.Plan;
            _tags = kept.Tags;
            _compare = kept.Compare;
            _flagged = kept.Flagged;
            _auto = kept.Auto;
            _chapterNames = kept.ChapterNames;
            ApplyProbe();
            ApplySubtitles();
            if (_probe == null)
            {
                _ = ReadStreams();
            }

            return;
        }

        _compare = [];
        _chapterNames = [];
        _profileId = playlist.Resolution == "2160p"
            ? _profiles.FirstOrDefault(p => p.Id == "uhd-remux")?.Id ?? _profiles.FirstOrDefault()?.Id ?? ""
            : _profiles.FirstOrDefault(p => p.Id == "bd-remux")?.Id ?? _profiles.FirstOrDefault()?.Id ?? "";
        BuildPlan();
        ResetTags();
        if (_probe == null)
        {
            _ = ReadStreams();
        }
    }

    /// <summary>
    /// The quick read of the selected playlist: mediainfo and sampled bit rates, a few seconds on
    /// a folder or a decrypted ISO. Picking another playlist drops a read still running.
    /// </summary>
    private async Task ReadStreams()
    {
        if (_selected == null || _analysis == null)
        {
            return;
        }

        _probeCancel?.Cancel();
        var cancel = _probeCancel = new CancellationTokenSource();
        var playlist = _selected;
        _probing = true;
        _probe = null;
        await InvokeAsync(StateHasChanged);
        ProbeResult result;
        try
        {
            result = await Task.Run(() => Probe.ProbeAsync(_source!, _analysis, playlist, cancel.Token), cancel.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (cancel.IsCancellationRequested || _selected != playlist)
        {
            return;
        }

        _probe = result;
        _probing = false;
        ApplyProbe();
        ApplySubtitles();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _probeCancel?.Cancel();
        _subtitleTimer?.Dispose();
    }

    private SubtitleScan? _subtitles;
    private HashSet<int> _compare = [];
    private Dictionary<int, string> _chapterNames = [];

    private void ToggleCompare((int Pid, bool On) change)
    {
        if (change.On)
        {
            _compare.Add(change.Pid);
        }
        else
        {
            _compare.Remove(change.Pid);
        }
    }
    private Timer? _subtitleTimer;

    /// <summary>Starts the subtitle read, quick or whole (it goes on if the page is left), and follows it.</summary>
    private void ReadSubtitles(bool quick)
    {
        if (_selected == null || _analysis == null)
        {
            return;
        }

        _subtitles = Scanner.Start(_source!, _analysis, _selected, quick);
        WatchSubtitles();
    }

    /// <summary>"Read subtitles": the OCR of every caption, after the preview.</summary>
    private void ReadAllText()
    {
        if (_subtitles != null && Scanner.StartFullText(_subtitles.Key) is { } scan)
        {
            _subtitles = scan;
            WatchSubtitles();
        }
    }

    /// <summary>Refreshes the page every second while the read runs.</summary>
    private void WatchSubtitles()
    {
        _subtitleTimer?.Dispose();
        _subtitleTimer = null;
        if (_subtitles is not { Running: true })
        {
            return;
        }

        var scan = _subtitles;
        _subtitleTimer = new Timer(_ => InvokeAsync(() =>
        {
            if (!scan.Running)
            {
                _subtitleTimer?.Dispose();
                _subtitleTimer = null;
                ApplySubtitles();
            }

            StateHasChanged();
        }), null, 1000, 1000);
    }

    /// <summary>
    /// The plan and guess version the read's SDH and commentary flags went on: once per plan and
    /// version, so an unticked flag stays unticked until "Read subtitles" brings new guesses.
    /// </summary>
    private (TrackPlan? Plan, int Version) _flagged;

    /// <summary>The SDH and commentary flags as the app last set them on each subtitle track: a difference is your choice.</summary>
    private Dictionary<int, (bool Sdh, bool Commentary)> _auto = [];

    /// <summary>
    /// The caption counts on the job's subtitle tracks, so the job keeps them too, and the SDH
    /// (when the profile detects SDH) and commentary flags the OCR of a sample found.
    /// </summary>
    private void ApplySubtitles()
    {
        if (_plan == null || _subtitles is not { Running: false, Error: null })
        {
            return;
        }

        var flag = _flagged != (_plan, _subtitles.GuessVersion);
        // After every caption was read, the guesses are firm: they set the flags both ways.
        var both = flag && _flagged.Plan == _plan && _subtitles.FullText;
        _flagged = (_plan, _subtitles.GuessVersion);
        foreach (var track in _plan.Tracks.Where(t => t.Kind == StreamKind.Subtitle))
        {
            // A flag changed by hand since the app last set it stays as you left it.
            var auto = _auto.GetValueOrDefault(track.Pid, (Sdh: track.HearingImpaired, Commentary: track.Commentary));
            var sdhByHand = track.HearingImpaired != auto.Sdh;
            var commentaryByHand = track.Commentary != auto.Commentary;
            if (_subtitles.Tracks.TryGetValue(track.Pid, out var read))
            {
                track.Details = _subtitles.Quick
                    ? $"{read.Captions:N0} elements in the sample"
                    : $"{read.Captions:N0} elements" + (read.Forced > 0 ? $", {read.Forced:N0} forced" : "");
                if (flag && Profile.DetectSdh && (read.Sdh || both) && !sdhByHand)
                {
                    track.HearingImpaired = read.Sdh;
                }

                if (flag && (read.Commentary || both) && !commentaryByHand)
                {
                    track.Commentary = read.Commentary;
                }
            }

            _auto[track.Pid] = (sdhByHand ? auto.Sdh : track.HearingImpaired, commentaryByHand ? auto.Commentary : track.Commentary);
        }
    }

    private string SubtitleFlagsNote
    {
        get
        {
            var sdh = _subtitles?.Tracks.Values.Count(t => t.Sdh) ?? 0;
            var commentary = _subtitles?.Tracks.Values.Count(t => t.Commentary) ?? 0;
            var parts = new List<string>();
            if (sdh > 0)
            {
                parts.Add(Profile.DetectSdh ? $"{sdh} SDH track{(sdh > 1 ? "s" : "")} found and ticked" : $"{sdh} SDH track{(sdh > 1 ? "s" : "")} found (the profile does not tick SDH by itself)");
            }

            if (commentary > 0)
            {
                parts.Add($"{commentary} commentary track{(commentary > 1 ? "s" : "")} guessed and ticked");
            }

            return parts.Count == 0 ? "" : "; " + string.Join(", ", parts);
        }
    }

    private void ApplyProbe()
    {
        if (_plan != null && _selected != null && _probe is { Error: null })
        {
            StreamProbe.Apply(_plan, _selected, _probe);
        }
    }

    private List<GlobalTag> _tags = [];

    /// <summary>The profile's own tags, keeping a value already typed for a tag of the same name.</summary>
    private void ResetTags()
    {
        var typed = _tags.Where(t => t.Value.Length > 0 && t.Name.Length > 0).GroupBy(t => t.Name).ToDictionary(g => g.Key, g => g.First().Value);
        _tags = Profile.CustomTags.Select(t => new GlobalTag { Name = t.Name, Value = typed.GetValueOrDefault(t.Name, t.Value) }).ToList();
    }

    private void BuildPlan()
    {
        if (_selected != null)
        {
            _plan = TrackPlanner.Build(_selected.Mpls, Profile, _original);
            _auto = _plan.Tracks.Where(t => t.Kind == StreamKind.Subtitle).ToDictionary(t => t.Pid, t => (t.HearingImpaired, t.Commentary));
            ApplyProbe();
            ApplySubtitles();
        }
    }

    private void ChangeProfile(ChangeEventArgs e)
    {
        _profileId = e.Value?.ToString() ?? "";
        BuildPlan();
        ResetTags();
    }

    private void ChangeOriginal(ChangeEventArgs e)
    {
        _original = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString()!.Trim().ToLowerInvariant();
        BuildPlan();
    }

    private async Task SearchOnEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Search();
        }
    }

    private async Task Search()
    {
        _searching = true;
        _searchError = null;
        (_matches, _searchError) = await Radarr.SearchAsync(_search, CancellationToken.None);
        if (_matches.Count == 0 && _searchError == null)
        {
            _searchError = "Radarr found nothing.";
        }

        _searching = false;
    }

    private MovieMatch? _adding;

    /// <summary>Adds the film to Radarr, then picks it.</summary>
    private async Task<string?> AddToRadarr(MovieMatch match, string root, int profile)
    {
        var (added, error) = await Radarr.AddAsync(match, root, profile, CancellationToken.None);
        if (added == null)
        {
            return error;
        }

        _adding = null;
        Pick(added);
        StateHasChanged(); // the form below is a child: its click does not redraw this page
        return null;
    }

    private void Pick(MovieMatch match)
    {
        _title = match.Title;
        _year = match.Year;
        _tmdb = match.TmdbId;
        _imdb = match.ImdbId;
        _original = match.OriginalLanguage;
        _matches = [];
        BuildPlan();
    }

    private Dictionary<string, string?> PreviewValues()
    {
        var video = _selected?.Mpls.Streams.FirstOrDefault(s => s.Kind == StreamKind.Video && !s.DolbyVisionEnhancementLayer);
        var audio = _plan?.Kept.FirstOrDefault(t => t.Kind == StreamKind.Audio && t.Default);
        var dv = _plan?.MergeDolbyVisionLayer == true;
        var uhd = video != null && StreamCoding.Resolution(video.Format) == "2160p";
        return new Dictionary<string, string?>
        {
            ["title"] = _title,
            ["year"] = _year?.ToString(),
            ["edition"] = _edition,
            ["resolution"] = video == null ? null : StreamCoding.Resolution(video.Format),
            ["videocodec"] = video?.CodecName,
            // SDR only for 2160p; a 1080p disc gets no HDR bracket.
            ["hdr"] = dv ? "DV HDR10" : uhd ? "HDR10" : null,
            ["audio"] = audio == null ? null : audio.Layout is "Multi" or "2.0 + Multi" ? audio.Codec : $"{audio.Codec}-{audio.Layout}",
            ["source"] = MuxBuilder.SourceInName(Profile.Source),
            ["country"] = Job.CountryCode(_country),
            ["releasegroup"] = MuxBuilder.ReleaseGroupWord(GlobalTag.Find(_tags, GlobalTag.ReleaseGroup))
        };
    }

    private string PreviewTitle => Naming.Apply(Profile.TitleTemplate, PreviewValues());

    private string PreviewFile => Naming.SafeFileName(Naming.Apply(Profile.FileNameTemplate, PreviewValues())) + ".mkv";

    /// <summary>The film's job as the form stands; the extras take its title, year, IDs and tags.</summary>
    private (Job? Job, string? Error) FilmJob()
    {
        if (string.IsNullOrWhiteSpace(_title) || _year is null)
        {
            return (null, "A title and a year are needed for the file name.");
        }

        if (_plan == null || !_plan.Kept.Any(t => t.Kind == StreamKind.Video))
        {
            return (null, "Keep at least the video track.");
        }

        return (new Job
        {
            SourcePath = _source!.Path,
            SourceKind = _source.Kind,
            SourceName = _source.Name,
            Playlist = _selected!.Name,
            Title = _title.Trim(),
            Year = _year,
            Edition = string.IsNullOrWhiteSpace(_edition) ? null : _edition.Trim(),
            ReleaseLabel = string.IsNullOrWhiteSpace(_label) ? null : _label.Trim(),
            SourceReleaseGroup = Job.SourceGroupOrOwnDisc(_sourceGroup),
            DiscTitle = _analysis?.DiscTitle,
            Country = Job.CountryCode(_country),
            TmdbId = _tmdb,
            ImdbId = string.IsNullOrWhiteSpace(_imdb) ? null : _imdb.Trim(),
            OriginalLanguage = _original,
            Profile = Profile,
            Plan = _plan,
            ChapterNames = _chapterNames.Where(n => !string.IsNullOrWhiteSpace(n.Value)).ToDictionary(n => n.Key, n => n.Value.Trim()),
            Tags = _tags.Where(t => t.Name.Length > 0).Select(t => t.Copy()).ToList()
        }, null);
    }

    private void Queue(bool dryRun)
    {
        _error = null;
        var (job, error) = FilmJob();
        if (job == null)
        {
            _error = error;
            return;
        }

        job.DryRun = dryRun;
        Runner.Enqueue(job);
        Navigation.NavigateTo($"job/{job.Id}");
    }
}

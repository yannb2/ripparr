@page "/discs/{Key}/compare"
@using Ripparr.Subtitles
@inject SubtitleScanner Scanner

<PageTitle>Compare subtitles · @(_scan?.SourceName ?? "Disc") · Ripparr</PageTitle>

@if (_scan == null || _tracks.Count == 0)
{
    <div class="alert alert-warning">This subtitle read is gone (only the last few are kept): read the subtitles again from the disc page.</div>
    return;
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-1">
    <h2 class="mb-0 me-auto">Compare subtitles <span class="text-body-secondary fs-5">@_scan.SourceName · playlist @_scan.Playlist</span></h2>
</div>
<div class="small text-body-secondary mb-3">
    Captions that show at the same time sit on the same row. A track with an empty cell where the others have dialogue
    is likely the forced ("foreign parts only") one.
</div>

<div class="d-flex flex-wrap align-items-center gap-3 mb-3 small">
    <span>@_rows.Count rows</span>
    <span class="ms-auto">
        <select class="form-select form-select-sm" style="width: auto" value="@_filter" @onchange="ChangeFilter">
            <option value="all">All rows</option>
            <option value="gaps">Only rows where a track has nothing</option>
            <option value="forced">Only rows with a forced caption</option>
        </select>
    </span>
</div>

@{
    var rows = Rows().ToList();
    var pages = Math.Max(1, (rows.Count + PageSize - 1) / PageSize);
    var page = Math.Min(_page, pages - 1);
}

<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-sm mb-0 small align-middle">
            <thead>
            <tr>
                <th>Time</th>
                @foreach (var track in _tracks)
                {
                    <th>
                        @track.Title
                        <div class="fw-normal text-body-secondary">@track.Captions.Count captions@(track.Captions.Count(c => c.Forced) is > 0 and var f ? $", {f} forced" : "")</div>
                    </th>
                }
            </tr>
            </thead>
            <tbody>
            @foreach (var row in rows.Skip(page * PageSize).Take(PageSize))
            {
                <tr>
                    <td class="text-nowrap font-monospace">@Srt.Time(row.Start)</td>
                    @for (var i = 0; i < _tracks.Count; i++)
                    {
                        var caption = row.Cells[i];
                        <td style="min-width: 14rem">
                            @if (caption != null)
                            {
                                <div class="sv-caption">
                                    <img src="api/discs/@Key/subtitles/@_tracks[i].Pid/@(caption.Index).png" loading="lazy" alt="caption @caption.Index"/>
                                </div>
                                @if (_tracks[i].Text.GetValueOrDefault(caption.Index)?.Text is { Length: > 0 } text)
                                {
                                    <div class="text-body-secondary" style="white-space: pre-line">@text</div>
                                }
                                @if (caption.Forced)
                                {
                                    <span class="badge text-bg-warning">forced</span>
                                }
                            }
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (pages > 1)
{
    <nav class="d-flex align-items-center gap-2 small">
        <button class="btn btn-sm btn-outline-secondary" disabled="@(page == 0)" @onclick="() => _page = page - 1"><i class="bi bi-chevron-left"></i></button>
        <span>Page @(page + 1) of @pages (@rows.Count rows)</span>
        <button class="btn btn-sm btn-outline-secondary" disabled="@(page >= pages - 1)" @onclick="() => _page = page + 1"><i class="bi bi-chevron-right"></i></button>
    </nav>
}

@code {
    private const int PageSize = 30;

    [Parameter] public string Key { get; set; } = "";

    /// <summary>The PIDs to compare, comma separated.</summary>
    [SupplyParameterFromQuery] public string? Pids { get; set; }

    private SubtitleScan? _scan;
    private List<(int Pid, string Title, List<PgsCaption> Captions, Dictionary<int, OcrCaption> Text)> _tracks = [];
    private List<CaptionAlignment.Row> _rows = [];
    private string _filter = "all";
    private int _page;

    protected override void OnParametersSet()
    {
        _scan = Scanner.Find(Key);
        _tracks = [];
        foreach (var part in (Pids ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct().Take(6))
        {
            if (int.TryParse(part, out var pid) && Scanner.SupFile(Key, pid) is { } sup && _scan!.Tracks.TryGetValue(pid, out var read))
            {
                var language = _scan.Languages.GetValueOrDefault(pid);
                var title = $"{(language == null ? "PID" : Languages.Name(language))} · PID {pid}"
                            + (read.Sdh ? " · SDH" : "") + (read.Commentary ? " · commentary?" : "");
                _tracks.Add((pid, title, CaptionCache.Get(sup), Scanner.Text(Key, pid)));
            }
        }

        _rows = CaptionAlignment.Align(_tracks.Select(t => (IReadOnlyList<PgsCaption>)t.Captions).ToList());
    }

    private IEnumerable<CaptionAlignment.Row> Rows() => _filter switch
    {
        "gaps" => _rows.Where(r => r.Cells.Any(c => c == null)),
        "forced" => _rows.Where(r => r.Cells.Any(c => c?.Forced == true)),
        _ => _rows
    };

    private void ChangeFilter(ChangeEventArgs e)
    {
        _filter = e.Value?.ToString() ?? "all";
        _page = 0;
    }
}

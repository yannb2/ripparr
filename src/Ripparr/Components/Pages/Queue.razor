@page "/queue"
@implements IDisposable
@inject JobStore Store
@inject JobRunner Runner
@inject JobEvents Events
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Options.IOptions<RipparrOptions> Options

<PageTitle>Queue · Ripparr</PageTitle>

<div class="d-flex align-items-center mb-3">
    <h2 class="mb-0 me-auto">Queue</h2>
    <div class="form-check form-switch mb-0 small">
        <input class="form-check-input" type="checkbox" id="showDry" @bind="_showDryRuns"/>
        <label class="form-check-label" for="showDry">Show dry runs</label>
    </div>
</div>

@if (!Shown.Any())
{
    <div class="alert alert-secondary">
        Nothing in the queue. Pick a disc on the <a href="">Sources</a> page; finished jobs are in <a href="history">History</a>.
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                <tr>
                    <th>#</th>
                    <th>Status</th>
                    <th>Title</th>
                    <th>Source</th>
                    <th style="min-width: 12rem">Step</th>
                    <th>Queued</th>
                    <th>Time</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var job in Shown)
                {
                    <tr class="sv-clickable-row" @onclick="() => Navigation.NavigateTo(Href(job))">
                        <td class="text-body-secondary">@job.Id</td>
                        <td><JobStatusBadge Job="job"/></td>
                        <td class="fw-semibold sv-file-name">@job.DisplayTitle</td>
                        <td class="small sv-file-name">@job.SourceName <span class="text-body-secondary">· @job.Playlist</span></td>
                        <td class="small">
                            @if (job.Status == JobStatus.Running)
                            {
                                <div class="sv-progress-pair" title="Top: the current step. Bottom: the whole job.">
                                    <div class="d-flex gap-2">
                                        <span>@job.Step</span>
                                        <span class="font-monospace ms-auto">@(job.Progress is { } stepDone ? $"{Math.Floor(stepDone * 100):0}%" : "")</span>
                                    </div>
                                    <div class="progress mb-1" style="height: 6px">
                                        <div class="progress-bar @(job.Progress == null ? "progress-bar-striped progress-bar-animated w-100 opacity-50" : "")"
                                             style="@(job.Progress is { } p ? $"width: {p * 100:0.#}%" : "")"></div>
                                    </div>
                                    <div class="d-flex gap-2 text-body-secondary">
                                        <span>Whole job</span>
                                        <span class="font-monospace ms-auto">@(job.Overall is { } overall ? $"{Math.Floor(overall * 100):0}%" : "")</span>
                                    </div>
                                    <div class="progress" style="height: 6px">
                                        <div class="progress-bar bg-success" style="width: @($"{(job.Overall ?? 0) * 100:0.#}")%"></div>
                                    </div>
                                </div>
                            }
                            else if (job.Status == JobStatus.Waiting)
                            {
                                <span class="text-warning-emphasis" title="@job.Question">@job.Step: needs an answer</span>
                            }
                            else if (job.Status is JobStatus.Failed or JobStatus.Interrupted)
                            {
                                <span class="text-danger" title="@job.Error">@job.Step</span>
                            }
                        </td>
                        <td class="small text-nowrap" title="@Format.LocalDate(job.Created)">@Format.TimeAgo(job.Created)</td>
                        <td class="small text-nowrap">@(job.Elapsed is { } e ? Format.Duration(e) : "")</td>
                        <td class="text-nowrap" @onclick:stopPropagation="true">
                            @if (job.CanRetry)
                            {
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => Retry(job)">Retry</button>
                            }
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Remove(job)"
                                    title="@(job.Status is JobStatus.Queued or JobStatus.Running ? "Cancel it; it shows in History as cancelled" : "Move it to History")">
                                <i class="bi bi-x-lg"></i> Remove
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<ConfirmDialog @ref="_confirm"/>

@code {
    private ConfirmDialog _confirm = null!;
    private List<Job> _jobs = [];
    private bool _showDryRuns = true;
    private DateTime _lastLoad = DateTime.MinValue;

    protected override void OnInitialized()
    {
        Load();
        Events.Changed += OnChanged;
    }

    private IEnumerable<Job> Shown => _jobs.Where(j => j.InQueue && (_showDryRuns || !j.DryRun));

    private void Load()
    {
        _jobs = Store.List(300);
        _lastLoad = DateTime.UtcNow;
    }

    private void OnChanged(long id)
    {
        if (DateTime.UtcNow - _lastLoad < TimeSpan.FromSeconds(1))
        {
            return;
        }

        InvokeAsync(() =>
        {
            Load();
            StateHasChanged();
        });
    }

    private void Retry(Job job)
    {
        Runner.Retry(job);
        Load();
    }

    private async Task Remove(Job job)
    {
        if (job.Status == JobStatus.Running &&
            !await _confirm.Ask("Remove job", $"{job.DisplayTitle} is running: stop it and move it to History?", "Stop and remove", danger: true))
        {
            return;
        }

        if (job.Status != JobStatus.Running && JobPipeline.WorkFolderInfo(Options.Value, job.Id) is { Mkv: { } mkv } folder &&
            !await _confirm.Ask("Remove job", $"Its work folder still holds {mkv} ({Format.Size(folder.Bytes)}), which did not pass its checks. " +
                                              "Removing the job deletes the folder with it.", "Remove and delete", danger: true))
        {
            return;
        }

        Runner.Remove(job.Id);
        Load();
    }

    private static string Href(Job job) => $"job/{job.Id}";

    public void Dispose() => Events.Changed -= OnChanged;
}

@page "/"
@inject IOptions<RipparrOptions> Options
@inject NavigationManager Navigation
@using Microsoft.Extensions.Options

<PageTitle>Sources · Ripparr</PageTitle>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h2 class="mb-0 me-auto">Sources</h2>
    <input class="form-control form-control-sm" style="max-width: 18rem" placeholder="Filter by name"
           @bind="_filter" @bind:event="oninput"/>
    <button class="btn btn-sm btn-outline-secondary" @onclick="Refresh" disabled="@_loading">
        <i class="bi bi-arrow-clockwise"></i> Look again
    </button>
</div>

@if (_folderProblems.Count > 0)
{
    <div class="alert alert-danger">
        <div class="fw-semibold mb-1"><i class="bi bi-exclamation-triangle"></i> Ripparr cannot write to these folders, so jobs will fail:</div>
        <ul class="mb-2">
            @foreach (var problem in _folderProblems)
            {
                <li>@problem.Name <code>@problem.Path</code>: @problem.Error</li>
            }
        </ul>
        <div class="small">They need to belong to the user the container runs as. On the host (the paths there may differ):
            <code>@FolderCheck.Hint(_folderProblems)</code></div>
    </div>
}

<p class="text-body-secondary small">
    ISO files and folders with a BDMV or VIDEO_TS (DVD) folder in
    @foreach (var (root, i) in Options.Value.Sources.Select((r, i) => (r, i)))
    {
        @(i > 0 ? ", " : "")<code>@root.Path</code><span class="@(Directory.Exists(root.Path) ? "" : "text-warning")">@(Directory.Exists(root.Path) ? "" : " (not mounted)")</span>
    }.
    The work and done folders are skipped.
</p>

@if (_loading)
{
    <div class="text-body-secondary"><span class="spinner-border spinner-border-sm me-2"></span>Looking for discs…</div>
}
else if (_sources.Count == 0)
{
    <div class="alert alert-secondary">No ISO files, BDMV or VIDEO_TS folders found.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                <tr>
                    <SortHeader Column="@SourceSort.Name" Label="Name" Current="@_sort" Descending="_descending" OnSort="Sort"/>
                    <SortHeader Column="@SourceSort.Kind" Label="Kind" Current="@_sort" Descending="_descending" OnSort="Sort"/>
                    <SortHeader Column="@SourceSort.Size" Label="Size" Current="@_sort" Descending="_descending" OnSort="Sort" Class="text-end"/>
                    <SortHeader Column="@SourceSort.Changed" Label="Changed" Current="@_sort" Descending="_descending" OnSort="Sort"/>
                    <SortHeader Column="@SourceSort.Where" Label="Where" Current="@_sort" Descending="_descending" OnSort="Sort"/>
                </tr>
                </thead>
                <tbody>
                @foreach (var source in Filtered)
                {
                    <tr class="sv-clickable-row" @onclick="() => Open(source)">
                        <td class="sv-file-name fw-semibold">@source.Name</td>
                        <td>
                            @if (source.Kind == SourceKind.Iso)
                            {
                                <span class="badge text-bg-secondary">ISO</span>
                            }
                            else if (source.Dvd)
                            {
                                <span class="badge text-bg-warning">DVD</span>
                            }
                            else
                            {
                                <span class="badge text-bg-info">BDMV</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">@Format.Size(source.Size)</td>
                        <td class="text-nowrap" title="@Format.LocalDate(source.Modified)">@Format.TimeAgo(source.Modified)</td>
                        <td class="sv-path text-body-secondary">@SourceSort.WhereText(source)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<DiscSource> _sources = [];
    private string _filter = "";
    private bool _loading = true;
    private List<FolderProblem> _folderProblems = [];

    // Sort column and direction live in the URL (?sort=size&dir=asc), so a
    // reload or a link keeps them.
    [SupplyParameterFromQuery(Name = "sort")] public string? SortParam { get; set; }
    [SupplyParameterFromQuery(Name = "dir")] public string? DirParam { get; set; }
    private string _sort = SourceSort.Default;
    private bool _descending = true;

    private IEnumerable<DiscSource> Filtered => SourceSort.Apply(string.IsNullOrWhiteSpace(_filter)
        ? _sources
        : _sources.Where(s => s.Name.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase)), _sort, _descending);

    protected override void OnParametersSet()
    {
        _sort = SourceSort.Column(SortParam);
        _descending = SourceSort.Descending(_sort, DirParam);
    }

    private void Sort(string column)
    {
        (_sort, _descending) = SourceSort.Click(_sort, _descending, column);
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["sort"] = _sort,
            ["dir"] = _descending ? "desc" : "asc"
        }), replace: true);
    }

    protected override async Task OnInitializedAsync() => await Refresh();

    private async Task Refresh()
    {
        _folderProblems = FolderCheck.Problems(Options.Value);
        _loading = true;
        var options = Options.Value;
        _sources = await Task.Run(() => SourceFinder.Find(options.Sources, [options.WorkFolder, options.DoneFolder, options.IsoMount.Folder]));
        _loading = false;
    }

    private void Open(DiscSource source) => Navigation.NavigateTo($"disc?path={Uri.EscapeDataString(source.Path)}");
}

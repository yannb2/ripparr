@page "/profiles/{Id}"
@inject JobStore Store
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Options.IOptions<RipparrOptions> Options

<PageTitle>@(_profile?.Name ?? "Profile") · Ripparr</PageTitle>

<div class="mb-2"><a href="profiles" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Profiles</a></div>

@if (_profile == null)
{
    <div class="alert alert-warning">There is no profile @Id.</div>
    return;
}

<div class="d-flex align-items-center mb-3 gap-2">
    <h2 class="mb-0 me-auto">@_profile.Name</h2>
    @if (_saved)
    {
        <span class="text-success small"><i class="bi bi-check"></i> Saved</span>
    }
    <button class="btn btn-primary" @onclick="Save">Save</button>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Profile</div>
            <div class="card-body">
                <label class="form-label small mb-1">Name</label>
                <input class="form-control form-control-sm mb-2" @bind="_profile.Name"/>
                <label class="form-label small mb-1">Description</label>
                <input class="form-control form-control-sm mb-2" @bind="_profile.Description"/>
                <label class="form-label small mb-1">Source word (SOURCE tag and last bracket)</label>
                <input class="form-control form-control-sm" @bind="_profile.Source"/>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">Video</div>
            <div class="card-body">
                <div class="small mb-3">
                    <span class="badge sv-dv me-1">DV</span>
                    <span class="text-body-secondary">
                        Dolby Vision enhancement layer: always merged. DGDemux writes the base layer and the enhancement layer
                        as separate streams, then Ripparr merges them back into one video track with <code>dovi_tool mux</code>
                        (profile 7 FEL stays FEL, MEL stays MEL). A disc without an enhancement layer is left as it is.
                    </span>
                </div>
                <label class="form-label small mb-1">Video language: <code>original</code>, <code>und</code> or a code</label>
                <input class="form-control form-control-sm mb-2" @bind="_profile.VideoLanguage"/>
                <label class="form-label small mb-1">Video track name: <code>{resolution}</code> <code>{codec}</code> <code>{hdr}</code>, empty for none</label>
                <input class="form-control form-control-sm" @bind="_profile.VideoNameTemplate"/>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">Chapters</div>
            <div class="card-body">
                <select class="form-select form-select-sm" value="@_profile.Chapters" @onchange="e => _profile.Chapters = Enum.Parse<ChapterNaming>(e.Value!.ToString()!)">
                    <option value="@ChapterNaming.Numbered">Chapter 01, Chapter 02…</option>
                    <option value="@ChapterNaming.None">Times only, no names</option>
                </select>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Audio</div>
            <div class="card-body">
                <label class="form-label small mb-1">Languages, in order (<code>original</code> = the film's language)</label>
                <input class="form-control form-control-sm mb-1" @bind="AudioLanguages"/>
                <div class="small text-body-secondary mb-2">@LanguageNames(_profile.AudioLanguages)</div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="otherAudio" @bind="_profile.KeepOtherAudioLanguages"/>
                    <label class="form-check-label" for="otherAudio">Also keep other languages</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="comm" @bind="_profile.KeepCommentary"/>
                    <label class="form-check-label" for="comm">Keep commentaries</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="lossy" @bind="_profile.DropLossyWhenLossless"/>
                    <label class="form-check-label" for="lossy">Drop a lossy track when a lossless one exists in the same language</label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="core" @bind="_profile.KeepTrueHdCore"/>
                    <label class="form-check-label" for="core">Keep the AC-3 core of TrueHD tracks as its own track</label>
                </div>
                <label class="form-label small mb-1">Track name: <code>{language}</code> <code>{codec}</code> <code>{channels}</code></label>
                <input class="form-control form-control-sm mb-2" @bind="_profile.AudioNameTemplate"/>
                <label class="form-label small mb-1">Commentary track name</label>
                <input class="form-control form-control-sm" @bind="_profile.CommentaryNameTemplate"/>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">Subtitles</div>
            <div class="card-body">
                <label class="form-label small mb-1">Languages, in order</label>
                <input class="form-control form-control-sm mb-1" @bind="SubtitleLanguages"/>
                <div class="small text-body-secondary mb-2">@LanguageNames(_profile.SubtitleLanguages)</div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="otherSubs" @bind="_profile.KeepOtherSubtitleLanguages"/>
                    <label class="form-check-label" for="otherSubs">Also keep other languages</label>
                </div>
                <label class="form-label small mb-1">Track name: <code>{language}</code></label>
                <input class="form-control form-control-sm mb-2" @bind="_profile.SubtitleNameTemplate"/>
                <label class="form-label small mb-1">Forced track name</label>
                <input class="form-control form-control-sm" @bind="_profile.ForcedSubtitleNameTemplate"/>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">Text subtitles (SRT by OCR)</div>
            <div class="card-body">
                <p class="small text-body-secondary mb-2">
                    Blu-ray subtitles are pictures. For these languages, Tesseract reads them and the MKV also gets an SRT track,
                    right after the picture track. Every job keeps its subtitle pictures for the preview.
                </p>
                <label class="form-label small mb-1">Languages (<code>original</code> = the film's language), empty for none</label>
                <input class="form-control form-control-sm mb-1" @bind="SrtLanguages" placeholder="eng, fre"/>
                <div class="small text-body-secondary mb-2">@LanguageNames(_profile.SrtLanguages)</div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="sdh" @bind="_profile.SrtRemoveSdh"/>
                    <label class="form-check-label" for="sdh">Remove the text for the hard of hearing: [door slams], (laughs), JOHN:, ♪ lyrics</label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="srtForced" @bind="_profile.SrtForForced"/>
                    <label class="form-check-label" for="srtForced">Also for forced subtitle tracks</label>
                </div>
                <label class="form-label small mb-1">Track name: <code>{language}</code></label>
                <input class="form-control form-control-sm mb-2" @bind="_profile.SrtNameTemplate"/>
                <label class="form-label small mb-1">Forced track name</label>
                <input class="form-control form-control-sm" @bind="_profile.ForcedSrtNameTemplate"/>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Output</div>
            <div class="card-body">
                <p class="small text-body-secondary mb-2">
                    Tokens: <code>{title}</code> <code>{year}</code> <code>{edition}</code> <code>{resolution}</code>
                    <code>{videocodec}</code> <code>{hdr}</code> <code>{audio}</code> <code>{source}</code>.
                    Text inside the braces is kept only when the token has a value: <code>{ - edition}</code>.
                </p>
                <label class="form-label small mb-1">File name</label>
                <input class="form-control form-control-sm mb-1 font-monospace" @bind="_profile.FileNameTemplate" @bind:event="oninput"/>
                <div class="small text-body-secondary mb-2">Example: <span class="sv-path">@(Example(_profile.FileNameTemplate)).mkv</span></div>
                <label class="form-label small mb-1">MKV title</label>
                <input class="form-control form-control-sm mb-1 font-monospace" @bind="_profile.TitleTemplate" @bind:event="oninput"/>
                <div class="small text-body-secondary mb-2">Example: @Example(_profile.TitleTemplate)</div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="tags" @bind="_profile.WriteTags"/>
                    <label class="form-check-label" for="tags">Write MKV global tags (TMDB, IMDB, SOURCE, RELEASE_NAME, EDITION, HDR_FORMAT, DV_PROFILE…)</label>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center">
                <span class="fw-semibold me-auto">DGDemux</span>
                @if (FullTemplate)
                {
                    <span class="badge text-bg-warning">own full command: the switches are not used</span>
                }
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="dgOnlyKept" @bind="_profile.DgDemux.DemuxOnlyKept" disabled="@FullTemplate"/>
                            <label class="form-check-label" for="dgOnlyKept">
                                Demux only the kept tracks (<code>-demux</code> with their PIDs), not the whole playlist: less to write on scratch
                            </label>
                        </div>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <label class="small text-nowrap" for="dgAngle">Angle (<code>-ang</code>)</label>
                            <input id="dgAngle" class="form-control form-control-sm" style="width: 5rem" type="number" min="0" max="9"
                                   @bind="_profile.DgDemux.Angle" disabled="@FullTemplate"/>
                            <span class="small text-body-secondary">0 = the first</span>
                        </div>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <label class="small text-nowrap" for="dgThd">TrueHD (<code>-thd</code>)</label>
                            <select id="dgThd" class="form-select form-select-sm" style="width: auto" disabled="@FullTemplate"
                                    value="@(_profile.DgDemux.ThdMode?.ToString() ?? "")"
                                    @onchange="e => _profile.DgDemux.ThdMode = int.TryParse(e.Value?.ToString(), out var m) ? m : null">
                                <option value="">From the profile (now @DgDemuxCommand.ThdMode(_profile))</option>
                                <option value="0">0: THD, embedded AC3 and THD+AC3</option>
                                <option value="1">1: THD and embedded AC3</option>
                                <option value="2">2: THD only</option>
                            </select>
                        </div>
                        <p class="small text-body-secondary mb-0">
                            Ripparr merges the Dolby Vision layer itself with dovi_tool and takes the chapters from the playlist,
                            so DGDemux's <code>-mergedv</code> and <code>-sslc</code> are not used.
                        </p>
                    </div>
                    <div class="col-md-6">
                        @foreach (var option in DgDemuxCommand.Switches)
                        {
                            var id = "dg" + option.Flag.TrimStart('-');
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="@id" checked="@option.Get(_profile.DgDemux)" disabled="@FullTemplate"
                                       @onchange="e => option.Set(_profile.DgDemux, e.Value is true)"/>
                                <label class="form-check-label" for="@id"><code>@option.Flag</code> @option.Label</label>
                            </div>
                        }
                    </div>
                </div>

                <label class="form-label small mb-1 mt-3">
                    Extra arguments, added at the end. A full command with <code>{input}</code> (the .mpls) and <code>{output}</code>
                    (the file name prefix) replaces the default <code>@Options.Value.DgDemuxArguments</code> and the switches above.
                </label>
                <div class="input-group input-group-sm mb-2">
                    <input class="form-control font-monospace" @bind="_profile.DgDemuxArguments" @bind:event="oninput"/>
                    <button class="btn btn-outline-secondary" disabled="@string.IsNullOrWhiteSpace(_profile.DgDemuxArguments)"
                            @onclick="() => _profile.DgDemuxArguments = string.Empty">Clear</button>
                </div>
                @if (FullTemplate && !_profile.DgDemuxArguments.Contains("{output}", StringComparison.Ordinal))
                {
                    <div class="small text-warning mb-2"><i class="bi bi-exclamation-triangle"></i> No <code>{output}</code>: DGDemux would only list the streams.</div>
                }
                <div class="small text-body-secondary mb-1">A job runs, in its demux folder (PIDs in decimal, as DGDemux wants them: video 4113, DV layer 4117, two audio, one subtitle):</div>
                <pre class="small bg-body-tertiary border rounded p-2 mb-3 text-wrap">@CommandPreview</pre>

                <div class="d-flex align-items-center gap-2 mb-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ShowHelp" disabled="@_helpRunning">
                        @if (_helpRunning)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <i class="bi bi-question-circle"></i>
                        }
                        Show DGDemux's own options
                    </button>
                    <span class="small text-body-secondary">Runs <code>@Options.Value.Tools.DgDemux -h</code> and shows what it prints: check the switches against your version.</span>
                </div>
                @if (_help != null)
                {
                    <pre class="small bg-body-tertiary border rounded p-2 mb-0" style="max-height: 24rem; overflow: auto">@_help</pre>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Id { get; set; } = "";

    private RipProfile? _profile;
    private bool _saved;

    protected override void OnParametersSet() => _profile = Store.Profile(Id);

    private string AudioLanguages
    {
        get => string.Join(", ", _profile!.AudioLanguages);
        set => _profile!.AudioLanguages = SplitList(value);
    }

    private string SubtitleLanguages
    {
        get => string.Join(", ", _profile!.SubtitleLanguages);
        set => _profile!.SubtitleLanguages = SplitList(value);
    }

    private string SrtLanguages
    {
        get => string.Join(", ", _profile!.SrtLanguages);
        set => _profile!.SrtLanguages = SplitList(value);
    }

    private static string LanguageNames(IEnumerable<string> codes) =>
        string.Join(", ", codes.Select(c => c == "original" ? "the film's language" : Languages.Name(c)));

    private static List<string> SplitList(string value) =>
        value.Split([',', ' '], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(v => v.ToLowerInvariant()).Distinct().ToList();

    private static string Example(string template) => Naming.Apply(template, new Dictionary<string, string?>
    {
        ["title"] = "Blade Runner", ["year"] = "1982", ["edition"] = "Final Cut", ["resolution"] = "2160p",
        ["videocodec"] = "HEVC", ["hdr"] = "DV HDR10", ["audio"] = "TrueHD Atmos-7.1", ["source"] = "BDRemux"
    });

    private string? _help;
    private bool _helpRunning;

    private bool FullTemplate => DgDemuxCommand.IsFullTemplate(_profile!.DgDemuxArguments);

    private string CommandPreview
    {
        get
        {
            var demux = System.IO.Path.Combine(Options.Value.WorkFolder, "job-12", "demux");
            var mpls = System.IO.Path.Combine(Options.Value.WorkFolder, "job-12", "disc", "BDMV", "PLAYLIST", "00800.mpls");
            int[] pids = [0x1011, 0x1015, 0x1100, 0x1101, 0x1200];
            return new ProcessSpec(Options.Value.Tools.DgDemux,
                DgDemuxCommand.Arguments(_profile!, Options.Value.DgDemuxArguments, mpls, System.IO.Path.Combine(demux, "00800"), pids)).CommandLine;
        }
    }

    /// <summary>DGDemux.txt next to the dgdemux binary, or in /config/tools.</summary>
    private static string? DgDemuxManual(string binary)
    {
        var folders = new List<string>();
        if (System.IO.Path.IsPathRooted(binary) && System.IO.Path.GetDirectoryName(binary) is { } folder)
        {
            folders.Add(folder);
        }

        folders.AddRange(["/config/tools", "/usr/local/bin"]);
        foreach (var candidate in folders.Distinct())
        {
            try
            {
                var file = Directory.EnumerateFiles(candidate)
                    .FirstOrDefault(f => System.IO.Path.GetFileName(f).Equals("DGDemux.txt", StringComparison.OrdinalIgnoreCase));
                if (file != null)
                {
                    return file;
                }
            }
            catch (Exception e) when (e is IOException or UnauthorizedAccessException)
            {
            }
        }

        return null;
    }

    private async Task ShowHelp()
    {
        _helpRunning = true;
        try
        {
            var result = await ProcessRunner.RunAsync(Options.Value.Tools.DgDemux, ["-h"], TimeSpan.FromSeconds(15));
            if ((result.Output + result.Error).Contains("DGDemux.txt", StringComparison.OrdinalIgnoreCase))
            {
                // dgdemux -h prints its manual, DGDemux.txt, from the zip; read it ourselves when it is next to the binary.
                var manual = DgDemuxManual(Options.Value.Tools.DgDemux);
                _help = manual != null
                    ? File.ReadAllText(manual)
                    : "dgdemux -h prints its manual, DGDemux.txt, which comes in the same zip as the binary. " +
                      "Put it next to dgdemux (/config/tools/DGDemux.txt, on the host /config/ripparr/tools/).";
                return;
            }


            _help = result.NotStarted
                ? $"{Options.Value.Tools.DgDemux} is not there. Put the Linux binary in /config/tools/dgdemux and restart the container."
                : string.Join("\n", new[] { result.Output.TrimEnd(), result.Error.TrimEnd() }.Where(t => t != "")) is { Length: > 0 } text
                    ? text
                    : $"DGDemux printed nothing (exit code {result.ExitCode}).";
        }
        finally
        {
            _helpRunning = false;
        }
    }

    private void Save()
    {
        Store.SaveProfile(_profile!);
        _saved = true;
    }
}

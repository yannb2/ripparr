@page "/profiles/new"
@page "/profiles/{Id}"
@inject JobStore Store
@inject NavigationManager Navigation
@inject Toasts Toasts
@inject Microsoft.Extensions.Options.IOptions<RipparrOptions> Options

<PageTitle>@(_profile?.Name ?? "Profile") · Ripparr</PageTitle>

@if (_profile == null)
{
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>There is no profile @Id.</div>
    return;
}

<nav class="mb-2">
    <a href="profiles" class="text-body-secondary small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Profiles</a>
</nav>
<h2 class="border-bottom pb-3 mb-4">
    <i class="bi bi-sliders me-2"></i>@(IsNew ? "New Profile" : $"Edit Profile: {_profile.Name}")
</h2>

<div class="row">
    <div class="col-md-3 col-lg-2 mb-3 mb-md-0">
        <div class="nav flex-column nav-pills sv-tab-row" role="tablist">
            @foreach (var (key, label, icon) in Tabs)
            {
                <button type="button" class="nav-link text-start @(_tab == key ? "active" : "")" @onclick="() => _tab = key">
                    <i class="bi @icon me-2"></i>@label
                </button>
            }
        </div>
    </div>

    <div class="col-md-9 col-lg-10">
        <div class="border rounded p-4">
            @switch (_tab)
            {
                case "general":
                    <h5 class="mb-3"><i class="bi bi-gear text-primary me-2"></i>General</h5>
                    <div class="mb-3">
                        <label class="form-label" for="name">Profile name</label>
                        <input id="name" class="form-control" @bind="_profile.Name"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="description">Description</label>
                        <input id="description" class="form-control" @bind="_profile.Description"/>
                        <small class="form-text text-muted d-block">Shown on the profile list.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="source">Source word</label>
                        <input id="source" class="form-control form-control-sm" style="max-width: 320px" @bind="_profile.Source"/>
                        <small class="form-text text-muted d-block">Written to the SOURCE tag and to <code>{source}</code>, the last bracket of the file name: BDRemux, DVDRemux.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="chapters">Chapters</label>
                        <select id="chapters" class="form-select form-select-sm" style="max-width: 320px" value="@_profile.Chapters"
                                @onchange="e => _profile.Chapters = Enum.Parse<ChapterNaming>(e.Value!.ToString()!)">
                            <option value="@ChapterNaming.Numbered">Chapter 01, Chapter 02…</option>
                            <option value="@ChapterNaming.None">Times only, no names</option>
                        </select>
                        <small class="form-text text-muted d-block">The chapter times come from the disc's playlist.</small>
                    </div>
                    break;

                case "tags":
                    <h5 class="mb-3"><i class="bi bi-tags text-primary me-2"></i>Global Tags</h5>
                    <Switch Id="tags" @bind-Value="_profile.WriteTags" Label="Write MKV global tags"
                            Help="The automatic tags below, as tag_release writes them, plus your own tags. Off: the MKV gets no global tags."/>
                    <div class="mb-4">
                        <div class="text-muted small mb-1">Automatic tags</div>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var (name, help) in AutomaticTags)
                            {
                                <span class="badge text-bg-light border" title="@help">@name</span>
                            }
                        </div>
                        <small class="form-text text-muted d-block">Hover a tag to see where its value comes from.</small>
                    </div>
                    <div class="mb-3">
                        <div class="text-muted small mb-1">Your own tags</div>
                        <GlobalTagEditor Tags="_profile.CustomTags" Disabled="!_profile.WriteTags" ValueLabel="Value a new job starts with"/>
                        <small class="form-text text-muted d-block">
                            Each job shows these on its form, to fill in or change: put a fixed value here (your release group) or leave it
                            empty to type it per disc. An empty value writes nothing. The value can use the file name placeholders:
                            <code>{title}</code> <code>{year}</code> <code>{edition}</code> <code>{resolution}</code> <code>{videocodec}</code>
                            <code>{hdr}</code> <code>{audio}</code> <code>{source}</code>. A tag with the name of an automatic one replaces it.
                        </small>
                    </div>
                    break;

                case "video":
                    <h5 class="mb-3"><i class="bi bi-film text-primary me-2"></i>Video Settings</h5>
                    <div class="mb-3 d-flex gap-2">
                        <span class="badge sv-dv align-self-start mt-1">DV</span>
                        <div>
                            <div class="fw-semibold">Dolby Vision enhancement layer: always merged</div>
                            <small class="form-text text-muted d-block">
                                DGDemux writes the base layer and the enhancement layer as separate streams, then Ripparr merges them
                                back into one video track with <code>dovi_tool mux</code> (profile 7 FEL stays FEL, MEL stays MEL).
                                A disc without an enhancement layer is left as it is.
                            </small>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="videoLanguage">Video track language</label>
                        <div class="d-flex gap-2 flex-wrap">
                            <select id="videoLanguage" class="form-select form-select-sm" style="max-width: 320px" value="@VideoLanguageMode" @onchange="SetVideoLanguageMode">
                                <option value="original">Original language (Radarr or TMDB)</option>
                                <option value="und">Undetermined (und)</option>
                                <option value="code">A language of my choice</option>
                            </select>
                            @if (VideoLanguageMode == "code")
                            {
                                <input class="form-control form-control-sm" style="max-width: 8rem" placeholder="eng" @bind="_profile.VideoLanguage"/>
                                <span class="small text-body-secondary align-self-center">@Languages.Name(_profile.VideoLanguage)</span>
                            }
                        </div>
                        <small class="form-text text-muted d-block">Players don't use it; it's for tidy media info. Blu-ray discs use the original language.</small>
                    </div>
                    <div class="mb-3">
                        <div class="text-muted small mb-1">Track name</div>
                        <input class="form-control form-control-sm font-monospace" @bind="_profile.VideoNameTemplate" @bind:event="oninput"/>
                        <small class="form-text text-muted d-block">
                            Placeholders: <code>{resolution}</code> (2160p, 1080p), <code>{codec}</code> (HEVC, AVC),
                            <code>{dv}</code> (Dolby Vision Profile 7 FEL), <code>{dvprofile}</code> (7, 8.1), <code>{dvlayer}</code> (FEL, MEL),
                            <code>{range}</code> (HDR10, HDR10+, HLG, or SDR for video with neither HDR nor Dolby Vision),
                            <code>{hdr}</code> (as Radarr: DV HDR10), <code>{language}</code>. Empty for no name.
                        </small>
                        <div class="mt-2 text-muted small mb-1">Dolby Vision wording</div>
                        <input class="form-control form-control-sm font-monospace" placeholder="@TrackNaming.DefaultDolbyVision"
                               @bind="_profile.DolbyVisionTemplate" @bind:event="oninput"/>
                        <small class="form-text text-muted d-block">
                            What <code>{dv}</code> writes, with <code>{dvprofile}</code> and <code>{dvlayer}</code>. Empty uses
                            <code>@TrackNaming.DefaultDolbyVision</code>; <code>DV P{dvprofile} {dvlayer}</code> gives "DV P7 FEL".
                            The profile and layer are read with dovi_tool once the layers are merged.
                        </small>
                        <NamePreview Rows="TrackNaming.Preview(_profile)"/>
                    </div>
                    break;

                case "audio":
                    <h5 class="mb-3"><i class="bi bi-volume-up text-primary me-2"></i>Audio Settings</h5>
                    <div class="mb-3">
                        <label class="form-label">Languages to keep, in order</label>
                        <LanguageListEditor Codes="_profile.AudioLanguages" EmptyText="No language: only other languages, if kept, or no audio at all."/>
                        <small class="form-text text-muted d-block">The first one found on the disc is the default track. Drag to reorder.</small>
                    </div>
                    <Switch Id="otherAudio" @bind-Value="_profile.KeepOtherAudioLanguages" Label="Also keep other languages"
                            Help="Keep the tracks in languages that are not in the list, after the listed ones."/>
                    <Switch Id="comm" @bind-Value="_profile.KeepCommentary" Label="Keep commentaries"
                            Help="Commentary tracks in a kept language: stereo tracks after the film's own tracks in the same language."/>
                    <Switch Id="lossy" @bind-Value="_profile.DropLossyWhenLossless" Label="Drop lossy duplicates"
                            Help="Drop a lossy track (AC-3, E-AC-3, DTS) when a lossless one (TrueHD, DTS-HD MA, PCM) exists in the same language."/>
                    <Switch Id="core" @bind-Value="_profile.KeepTrueHdCore" Label="Keep the AC-3 core of TrueHD tracks"
                            Help="DGDemux writes the AC-3 core apart (-thd 1); it becomes its own track after the TrueHD one."/>
                    <div class="mb-3">
                        <div class="text-muted small mb-1">Track name</div>
                        <input class="form-control form-control-sm font-monospace" @bind="_profile.AudioNameTemplate" @bind:event="oninput"/>
                        <small class="form-text text-muted d-block">
                            Placeholders: <code>{language}</code>, <code>{codec}</code> (TrueHD Atmos, DTS-HD MA), <code>{channels}</code> (7.1),
                            <code>{dub}</code> (Dub on audio in another language than the film's own), <code>{description}</code>
                            (Commentary on a commentary), <code>{commentary}</code>, <code>{ad}</code>.
                        </small>
                        <FlagOverrides Overrides="_profile.AudioNameOverrides" Changed="StateHasChanged"/>
                        <NamePreview Rows="TrackNaming.AudioPreview(_profile)"/>
                    </div>
                    break;

                case "subtitles":
                    <h5 class="mb-3"><i class="bi bi-chat-text text-primary me-2"></i>Subtitle Settings</h5>
                    <div class="mb-3">
                        <label class="form-label">Languages to keep, in order</label>
                        <LanguageListEditor Codes="_profile.SubtitleLanguages" EmptyText="No language: only other languages, if kept, or no subtitles at all."/>
                    </div>
                    <Switch Id="otherSubs" @bind-Value="_profile.KeepOtherSubtitleLanguages" Label="Also keep other languages"
                            Help="Keep the subtitle tracks in languages that are not in the list."/>
                    <div class="mb-3">
                        <div class="text-muted small mb-1">Track name</div>
                        <input class="form-control form-control-sm font-monospace" @bind="_profile.SubtitleNameTemplate" @bind:event="oninput"/>
                        <small class="form-text text-muted d-block">
                            Placeholders: <code>{language}</code>, <code>{codec}</code> (PGS, or SRT for the OCR tracks), <code>{dub}</code>,
                            <code>{trackname}</code> (empty for disc tracks), <code>{forced}</code>, <code>{sdh}</code>, <code>{commentary}</code>.
                        </small>
                        <FlagOverrides Overrides="_profile.SubtitleNameOverrides" Changed="StateHasChanged"/>
                        <NamePreview Rows="TrackNaming.SubtitlePreview(_profile)"/>
                    </div>

                    <h6 class="mt-4 mb-2 border-top pt-3"><i class="bi bi-fonts text-primary me-2"></i>Text subtitles (SRT by OCR)</h6>
                    <p class="small text-body-secondary mb-2">
                        Blu-ray subtitles are pictures. For these languages, Tesseract reads them and the MKV also gets an SRT track,
                        right after the picture track, named with the templates above and <code>{codec}</code> = SRT.
                        Every job keeps its subtitle pictures for the preview.
                    </p>
                    <div class="mb-3">
                        <LanguageListEditor Codes="_profile.SrtLanguages" Numbered="false" EmptyText="No SRT tracks."/>
                    </div>
                    <Switch Id="sdh" @bind-Value="_profile.SrtRemoveSdh" Label="Remove the text for the hard of hearing"
                            Help="[door slams], (laughs), JOHN:, ♪ lyrics are left out of the SRT; a caption with nothing else is dropped."/>
                    <Switch Id="detectSdh" @bind-Value="_profile.DetectSdh" Label="Mark SDH subtitle tracks"
                            Help="When the OCR finds SDH text in a tenth of the captions or more, the picture track gets the hearing impaired flag and the SDH name."/>
                    <Switch Id="srtForced" @bind-Value="_profile.SrtForForced" Label="Also for forced subtitle tracks"
                            Help="Make an SRT of the forced (foreign lines only) tracks too."/>
                    break;

                case "output":
                    <h5 class="mb-3"><i class="bi bi-file-earmark-play text-primary me-2"></i>File Name and Title</h5>
                    <div class="mb-3">
                        <div class="text-muted small mb-1">File name</div>
                        <input class="form-control form-control-sm font-monospace" @bind="_profile.FileNameTemplate" @bind:event="oninput"/>
                        <small class="form-text text-muted d-block">
                            Placeholders: <code>{title}</code> <code>{year}</code> <code>{edition}</code> <code>{resolution}</code>
                            <code>{videocodec}</code> <code>{hdr}</code> <code>{audio}</code> <code>{source}</code>.
                            Text inside the braces is kept only when the placeholder has a value: <code>{ - edition}</code>.
                        </small>
                        <div class="mt-2 text-muted small"><i class="bi bi-eye me-1"></i>Preview: <code>@(Example(_profile.FileNameTemplate)).mkv</code></div>
                    </div>
                    <div class="mb-3">
                        <div class="text-muted small mb-1">MKV title</div>
                        <input class="form-control form-control-sm font-monospace" @bind="_profile.TitleTemplate" @bind:event="oninput"/>
                        <small class="form-text text-muted d-block">The same placeholders.</small>
                        <div class="mt-2 text-muted small"><i class="bi bi-eye me-1"></i>Preview: <code>@Example(_profile.TitleTemplate)</code></div>
                    </div>
                    <h6 class="mt-4 mb-2">TV episodes</h6>
                    <div class="mb-3">
                        <div class="text-muted small mb-1">Episode file name</div>
                        <input class="form-control form-control-sm font-monospace" @bind="_profile.EpisodeFileNameTemplate" @bind:event="oninput"/>
                        <small class="form-text text-muted d-block">
                            The same placeholders (<code>{title}</code> is the series) and <code>{episode}</code> (S01E05),
                            <code>{absolute}</code> (005, anime series only) and <code>{episodetitle}</code>.
                        </small>
                        <div class="mt-2 text-muted small"><i class="bi bi-eye me-1"></i>Preview: <code>@(Episode(_profile.EpisodeFileNameTemplate)).mkv</code></div>
                    </div>
                    <div class="mb-3">
                        <div class="text-muted small mb-1">Episode MKV title</div>
                        <input class="form-control form-control-sm font-monospace" @bind="_profile.EpisodeTitleTemplate" @bind:event="oninput"/>
                        <div class="mt-2 text-muted small"><i class="bi bi-eye me-1"></i>Preview: <code>@Episode(_profile.EpisodeTitleTemplate)</code></div>
                    </div>
                    break;

                case "dgdemux":
                    <h5 class="mb-3 d-flex align-items-center flex-wrap gap-2">
                        <span><i class="bi bi-terminal text-primary me-2"></i>DGDemux</span>
                        @if (FullTemplate)
                        {
                            <span class="badge text-bg-warning fw-normal">own full command: the switches are not used</span>
                        }
                    </h5>
                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="dgOnlyKept" @bind="_profile.DgDemux.DemuxOnlyKept" disabled="@FullTemplate"/>
                        <label class="form-check-label" for="dgOnlyKept">Demux only the kept tracks</label>
                        <small class="form-text text-muted d-block"><code>-demux</code> with their PIDs, not the whole playlist: less to write on scratch.</small>
                    </div>
                    @foreach (var option in DgDemuxCommand.Switches)
                    {
                        var id = "dg" + option.Flag.TrimStart('-');
                        <div class="mb-3 form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="@id" checked="@option.Get(_profile.DgDemux)" disabled="@FullTemplate"
                                   @onchange="e => option.Set(_profile.DgDemux, e.Value is true)"/>
                            <label class="form-check-label" for="@id"><code>@option.Flag</code></label>
                            <small class="form-text text-muted d-block">@option.Label</small>
                        </div>
                    }
                    <div class="mb-3 d-flex flex-wrap gap-3">
                        <div>
                            <label class="form-label small mb-1" for="dgAngle">Angle (<code>-ang</code>)</label>
                            <input id="dgAngle" class="form-control form-control-sm" style="width: 6rem" type="number" min="0" max="9"
                                   @bind="_profile.DgDemux.Angle" disabled="@FullTemplate"/>
                            <small class="form-text text-muted d-block">0 = the first</small>
                        </div>
                        <div>
                            <label class="form-label small mb-1" for="dgThd">TrueHD (<code>-thd</code>)</label>
                            <select id="dgThd" class="form-select form-select-sm" style="width: auto" disabled="@FullTemplate"
                                    value="@(_profile.DgDemux.ThdMode?.ToString() ?? "")"
                                    @onchange="e => _profile.DgDemux.ThdMode = int.TryParse(e.Value?.ToString(), out var m) ? m : null">
                                <option value="">From the profile (now @DgDemuxCommand.ThdMode(_profile))</option>
                                <option value="0">0: THD, embedded AC3 and THD+AC3</option>
                                <option value="1">1: THD and embedded AC3</option>
                                <option value="2">2: THD only</option>
                            </select>
                        </div>
                    </div>
                    <small class="form-text text-muted d-block mb-3">
                        Ripparr merges the Dolby Vision layer itself with dovi_tool and takes the chapters from the playlist,
                        so DGDemux's <code>-mergedv</code> and <code>-sslc</code> are not used.
                    </small>

                    <div class="text-muted small mb-1">Extra arguments</div>
                    <div class="input-group input-group-sm">
                        <input class="form-control font-monospace" @bind="_profile.DgDemuxArguments" @bind:event="oninput"/>
                        <button class="btn btn-outline-secondary" disabled="@string.IsNullOrWhiteSpace(_profile.DgDemuxArguments)"
                                @onclick="() => _profile.DgDemuxArguments = string.Empty">Clear</button>
                    </div>
                    <small class="form-text text-muted d-block mb-2">
                        Added at the end. A full command with <code>{input}</code> (the .mpls) and <code>{output}</code>
                        (the file name prefix) replaces the default <code>@Options.Value.DgDemuxArguments</code> and the switches above.
                    </small>
                    @if (FullTemplate && !_profile.DgDemuxArguments.Contains("{output}", StringComparison.Ordinal))
                    {
                        <div class="small text-warning mb-2"><i class="bi bi-exclamation-triangle"></i> No <code>{output}</code>: DGDemux would only list the streams.</div>
                    }
                    <div class="text-muted small mb-1"><i class="bi bi-eye me-1"></i>A job runs, in its demux folder (PIDs in decimal, as DGDemux wants them: video 4113, DV layer 4117, two audio, one subtitle):</div>
                    <pre class="small bg-body-tertiary border rounded p-2 mb-3 text-wrap">@CommandPreview</pre>

                    <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ShowHelp" disabled="@_helpRunning">
                            @if (_helpRunning)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <i class="bi bi-question-circle"></i>
                            }
                            Show DGDemux's own options
                        </button>
                        <span class="small text-body-secondary">Runs <code>@Options.Value.Tools.DgDemux -h</code> and shows what it prints: check the switches against your version.</span>
                    </div>
                    @if (_help != null)
                    {
                        <pre class="small bg-body-tertiary border rounded p-2 mb-0" style="max-height: 24rem; overflow: auto">@_help</pre>
                    }
                    break;
            }
        </div>
    </div>
</div>

<StickyBar>
    <button type="button" class="btn btn-primary" @onclick="Save">
        <i class="bi bi-save me-2"></i>Save Settings
    </button>
    <button type="button" class="btn btn-outline-secondary ms-auto" @onclick="SaveAndClose">
        <i class="bi bi-box-arrow-left me-2"></i>Save and Close
    </button>
</StickyBar>

@code {
    private static readonly (string Key, string Label, string Icon)[] Tabs =
    [
        ("general", "General", "bi-gear"),
        ("video", "Video", "bi-film"),
        ("audio", "Audio", "bi-volume-up"),
        ("subtitles", "Subtitles", "bi-chat-text"),
        ("output", "File name", "bi-file-earmark-play"),
        ("tags", "Tags", "bi-tags"),
        ("dgdemux", "DGDemux", "bi-terminal")
    ];

    [Parameter] public string? Id { get; set; }

    private static readonly (string Name, string Help)[] AutomaticTags =
    [
        ("TMDB", "movie/<id>, from Radarr or the job form"),
        ("IMDB", "tt…, from Radarr or the job form"),
        ("RELEASE_NAME", "the ISO or folder name"),
        ("SOURCE", "the profile's source word"),
        ("VIDEO_CODEC", "HEVC, AVC… from MediaInfo"),
        ("HDR_FORMAT", "DV HDR10, HDR10… from MediaInfo"),
        ("DV_PROFILE", "the Dolby Vision profile"),
        ("EDITION", "the job's edition"),
        ("ORIGINAL_LANGUAGE", "the film's language"),
        ("RIPPED_WITH", "Ripparr's version and the playlist")
    ];

    private RipProfile? _profile;
    private string _tab = "general";
    private string? _loadedFor;
    private bool IsNew => Id == null;

    protected override void OnParametersSet()
    {
        // Load once per address: saving a new profile moves to its own address without reloading it.
        var key = Id ?? "new";
        if (_loadedFor != key && !(IsNew == false && _profile?.Id == Id))
        {
            _profile = IsNew ? new RipProfile() : Store.Profile(Id!);
        }

        _loadedFor = key;
    }

    private string VideoLanguageMode => _profile!.VideoLanguage is "original" or "und" ? _profile.VideoLanguage : "code";

    private void SetVideoLanguageMode(ChangeEventArgs e)
    {
        var mode = e.Value?.ToString() ?? "original";
        _profile!.VideoLanguage = mode == "code" ? "eng" : mode;
    }

    private static string Example(string template) => Naming.Apply(template, new Dictionary<string, string?>
    {
        ["title"] = "Blade Runner", ["year"] = "1982", ["edition"] = "Final Cut", ["resolution"] = "2160p",
        ["videocodec"] = "HEVC", ["hdr"] = "DV HDR10", ["audio"] = "TrueHD Atmos-7.1", ["source"] = "BDRemux"
    });

    private static string Episode(string template) => Naming.Apply(template, new Dictionary<string, string?>
    {
        ["title"] = "Frieren - Beyond Journey's End", ["year"] = "2023", ["resolution"] = "1080p", ["videocodec"] = "AVC",
        ["hdr"] = "SDR", ["audio"] = "TrueHD-2.0", ["source"] = "BDRemux", ["episode"] = "S01E05", ["absolute"] = "005",
        ["episodetitle"] = "Phantoms of the Dead"
    });

    private bool Write()
    {
        if (string.IsNullOrWhiteSpace(_profile!.Name))
        {
            Toasts.Error("The profile needs a name.");
            _tab = "general";
            return false;
        }

        _profile.Name = _profile.Name.Trim();
        Store.SaveProfile(_profile);
        Toasts.Success($"Profile '{_profile.Name}' saved.");
        return true;
    }

    private void Save()
    {
        if (Write() && IsNew)
        {
            Navigation.NavigateTo($"profiles/{_profile!.Id}");
        }
    }

    private void SaveAndClose()
    {
        if (Write())
        {
            Navigation.NavigateTo("profiles");
        }
    }

    private string? _help;
    private bool _helpRunning;

    private bool FullTemplate => DgDemuxCommand.IsFullTemplate(_profile!.DgDemuxArguments);

    private string CommandPreview
    {
        get
        {
            var demux = System.IO.Path.Combine(Options.Value.WorkFolder, "job-12", "demux");
            var mpls = System.IO.Path.Combine(Options.Value.WorkFolder, "job-12", "disc", "BDMV", "PLAYLIST", "00800.mpls");
            int[] pids = [0x1011, 0x1015, 0x1100, 0x1101, 0x1200];
            return new ProcessSpec(Options.Value.Tools.DgDemux,
                DgDemuxCommand.Arguments(_profile!, Options.Value.DgDemuxArguments, mpls, System.IO.Path.Combine(demux, "00800"), pids)).CommandLine;
        }
    }

    /// <summary>DGDemux.txt next to the dgdemux binary, or in /config/tools.</summary>
    private static string? DgDemuxManual(string binary)
    {
        var folders = new List<string>();
        if (System.IO.Path.IsPathRooted(binary) && System.IO.Path.GetDirectoryName(binary) is { } folder)
        {
            folders.Add(folder);
        }

        folders.AddRange(["/config/tools", "/usr/local/bin"]);
        foreach (var candidate in folders.Distinct())
        {
            try
            {
                var file = Directory.EnumerateFiles(candidate)
                    .FirstOrDefault(f => System.IO.Path.GetFileName(f).Equals("DGDemux.txt", StringComparison.OrdinalIgnoreCase));
                if (file != null)
                {
                    return file;
                }
            }
            catch (Exception e) when (e is IOException or UnauthorizedAccessException)
            {
            }
        }

        return null;
    }

    private async Task ShowHelp()
    {
        _helpRunning = true;
        try
        {
            var result = await ProcessRunner.RunAsync(Options.Value.Tools.DgDemux, ["-h"], TimeSpan.FromSeconds(15));
            if ((result.Output + result.Error).Contains("DGDemux.txt", StringComparison.OrdinalIgnoreCase))
            {
                // dgdemux -h prints its manual, DGDemux.txt, from the zip; read it ourselves when it is next to the binary.
                var manual = DgDemuxManual(Options.Value.Tools.DgDemux);
                _help = manual != null
                    ? File.ReadAllText(manual)
                    : "dgdemux -h prints its manual, DGDemux.txt, which comes in the same zip as the binary. " +
                      "Put it next to dgdemux (/config/tools/DGDemux.txt, on the host /config/ripparr/tools/).";
                return;
            }


            _help = result.NotStarted
                ? $"{Options.Value.Tools.DgDemux} is not there. Put the Linux binary in /config/tools/dgdemux and restart the container."
                : string.Join("\n", new[] { result.Output.TrimEnd(), result.Error.TrimEnd() }.Where(t => t != "")) is { Length: > 0 } text
                    ? text
                    : $"DGDemux printed nothing (exit code {result.ExitCode}).";
        }
        finally
        {
            _helpRunning = false;
        }
    }

}

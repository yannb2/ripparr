@* One episode's or extra's tracks: the film's track table for that playlist, with its subtitle check and
   preview, a reset and "same for all". *@
@implements IDisposable
@inject SubtitleScanner Scanner

<div class="border rounded p-2 my-1 bg-body-tertiary">
    <div class="d-flex flex-wrap align-items-center gap-2 small mb-2">
        <span class="fw-semibold">Tracks of @Playlist.Name</span>
        <span class="text-body-secondary">Untick what you don't want; language, flags, description and order as for a film.</span>
        <div class="ms-auto d-flex gap-2">
            @if (CopyToOthers != null)
            {
                <button class="btn btn-sm btn-outline-secondary py-0" @onclick="Copy"
                        title="Gives the other ticked @Others the same choices, track by track (same PID)">
                    <i class="bi bi-files me-1"></i>Same for all @Others
                </button>
            }
            <button class="btn btn-sm btn-outline-secondary py-0" @onclick="Reset" title="Back to what the profile picks">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset to the profile
            </button>
        </div>
    </div>
    @if (_note != null)
    {
        <div class="small text-body-secondary mb-2"><i class="bi bi-info-circle me-1"></i>@_note</div>
    }

    @* The subtitle checks read Blu-ray picture subtitles (PGS); a DVD's (VobSub) go in as they are. *@
    @if (Playlist.Mpls.Streams.Any(s => s.Kind == StreamKind.Subtitle && s.Coding == StreamCoding.Pgs))
    {
        <div class="d-flex flex-wrap align-items-center gap-2 small mb-2">
            @if (_subtitles is { Running: true } running)
            {
                <span class="spinner-border spinner-border-sm text-secondary"></span>
                <span class="text-body-secondary">@running.Stage, @((running.Progress * 100).ToString("0"))%…</span>
                <div class="progress flex-grow-1" style="height: 6px; max-width: 20rem">
                    <div class="progress-bar" style="width: @((running.Progress * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                </div>
            }
            else if (_subtitles is { Error: { } subtitleError })
            {
                <i class="bi bi-info-circle text-body-secondary"></i>
                <span class="text-body-secondary">@subtitleError</span>
                <button class="btn btn-sm btn-link p-0" @onclick="() => ReadSubtitles(_subtitles.Quick)">Try again</button>
            }
            else if (_subtitles != null)
            {
                <span class="w-100 order-last d-flex flex-wrap align-items-center gap-2 mt-1">
                    @if (State.Compare.Count >= 2)
                    {
                        <a class="btn btn-sm btn-outline-secondary" target="_blank"
                           href="@($"discs/{_subtitles.Key}/compare?pids={string.Join(',', _subtitles.Tracks.Keys.Where(State.Compare.Contains))}")">
                            <i class="bi bi-layout-three-columns"></i> Side by side (@State.Compare.Count tracks)
                        </a>
                        <button class="btn btn-sm btn-link p-0" @onclick="() => State.Compare.Clear()">clear</button>
                    }
                    else
                    {
                        <span class="text-body-secondary">Compare: tick <i class="bi bi-layout-three-columns"></i> compare on two or more subtitle tracks below, then open Side by side</span>
                    }
                </span>
                <i class="bi bi-check2 text-success"></i>
                <span class="text-body-secondary">
                    @if (_subtitles.Quick)
                    {
                        @($"Checked in {Took(_subtitles)}, on {_subtitles.QuickNote}: ")
                        <span>caption counts from that sample only@(FlagsNote).</span>
                    }
                    else
                    {
                        @($"{(_subtitles.FullText ? "Subtitles read" : "Subtitles previewed")} in {Took(_subtitles)}: ")
                        <span>caption counts and <i class="bi bi-eye"></i> previews below@(FlagsNote).</span>
                    }
                </span>
                @if (_subtitles.Stage.StartsWith("The OCR failed", StringComparison.Ordinal))
                {
                    <span class="text-danger">@_subtitles.Stage</span>
                }
                @if (_subtitles.Quick)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ReadSubtitles(false)"
                            title="Reads the whole playlist once: exact caption counts, forced captions and every caption in the preview">
                        <i class="bi bi-badge-cc"></i> Preview subtitles (whole playlist)
                    </button>
                }
                else if (!_subtitles.FullText)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ReadAllText"
                            title="Tesseract reads every caption of every track: SDH and commentary checked on all of them, and the text shows in the preview and compare pages.">
                        <i class="bi bi-fonts"></i> Read subtitles
                    </button>
                }
            }
            else
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => ReadSubtitles(true)"
                        title="Reads a few slices spread over the playlist and checks a sample of each track's captions for SDH and commentary text">
                    <i class="bi bi-search"></i> Check SDH and commentary
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => ReadSubtitles(false)"
                        title="Reads the whole playlist once for each subtitle track's exact caption count, forced captions, a preview and the SDH / commentary check">
                    <i class="bi bi-badge-cc"></i> Preview subtitles
                </button>
                <span class="text-body-secondary">The check takes seconds; the preview reads the whole playlist for exact counts and forced captions.</span>
            }
        </div>
    }

    <TrackPlanEditor Plan="Plan" ListenUrl="@(CanListen ? ListenUrl : null)" Subtitles="_subtitles"
                     Compare="@(_subtitles is { Running: false, Error: null } ? State.Compare : null)" CompareChanged="ToggleCompare"/>
</div>

@code {
    [Parameter, EditorRequired] public DiscSource Source { get; set; } = null!;
    [Parameter, EditorRequired] public DiscAnalysis Analysis { get; set; } = null!;
    [Parameter, EditorRequired] public PlaylistInfo Playlist { get; set; } = null!;
    [Parameter, EditorRequired] public TrackPlan Plan { get; set; } = null!;

    /// <summary>What the subtitle read set on this playlist's plan; kept by the row while the panel is closed.</summary>
    [Parameter, EditorRequired] public PlaylistTracksState State { get; set; } = null!;

    /// <summary>The profile ticks SDH by itself when the read finds it.</summary>
    [Parameter] public bool DetectSdh { get; set; }

    /// <summary>ffmpeg can cut a sample (not encrypted, the ISO mounted): Listen buttons on audio tracks.</summary>
    [Parameter] public bool CanListen { get; set; }

    /// <summary>"episodes" or "extras": what Same for all copies to.</summary>
    [Parameter] public string Others { get; set; } = "episodes";

    /// <summary>Copies this plan to the other ticked rows: how many took it, how many have none of its tracks.</summary>
    [Parameter] public Func<TrackPlan, (int Copied, int Skipped)>? CopyToOthers { get; set; }

    /// <summary>After Same for all: the other rows' open track tables show the copy.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    /// <summary>Asks for a fresh plan from the profile.</summary>
    [Parameter] public EventCallback Reset { get; set; }

    private string? _note;
    private SubtitleScan? _subtitles;
    private Timer? _timer;

    protected override void OnParametersSet()
    {
        if (State.Plan != Plan)
        {
            SubtitleFlags.Reset(Plan, State);
        }

        // A read started earlier (or still running) for this playlist.
        _subtitles ??= Scanner.Find(Source, Playlist);
        if (_subtitles is { Running: true })
        {
            Watch();
        }
        else
        {
            ApplySubtitles();
        }
    }

    private static string Took(SubtitleScan scan) =>
        scan.Took.TotalSeconds < 60 ? $"{scan.Took.TotalSeconds:0.#} s" : Format.Duration(scan.Took);

    private string ListenUrl(PlannedTrack track) =>
        $"api/discs/listen/{track.Pid}.m4a?path={Uri.EscapeDataString(Source.Path)}&playlist={Uri.EscapeDataString(Playlist.Name)}";

    private void ToggleCompare((int Pid, bool On) change)
    {
        if (change.On)
        {
            State.Compare.Add(change.Pid);
        }
        else
        {
            State.Compare.Remove(change.Pid);
        }
    }

    private void ReadSubtitles(bool quick)
    {
        _subtitles = Scanner.Start(Source, Analysis, Playlist, quick);
        Watch();
    }

    private void ReadAllText()
    {
        if (_subtitles != null && Scanner.StartFullText(_subtitles.Key) is { } scan)
        {
            _subtitles = scan;
            Watch();
        }
    }

    /// <summary>Redraws every second while the read runs, then puts its counts and flags on the plan.</summary>
    private void Watch()
    {
        if (_timer != null || _subtitles is not { Running: true })
        {
            return;
        }

        var scan = _subtitles;
        _timer = new Timer(_ => InvokeAsync(() =>
        {
            if (!scan.Running)
            {
                _timer?.Dispose();
                _timer = null;
                ApplySubtitles();
            }

            StateHasChanged();
        }), null, 1000, 1000);
    }

    private void ApplySubtitles()
    {
        if (_subtitles != null)
        {
            SubtitleFlags.Apply(Plan, State, _subtitles, DetectSdh);
        }
    }

    private string FlagsNote
    {
        get
        {
            var sdh = _subtitles?.Tracks.Values.Count(t => t.Sdh) ?? 0;
            var commentary = _subtitles?.Tracks.Values.Count(t => t.Commentary) ?? 0;
            var parts = new List<string>();
            if (sdh > 0)
            {
                parts.Add(DetectSdh ? $"{sdh} SDH track{(sdh > 1 ? "s" : "")} found and ticked" : $"{sdh} SDH track{(sdh > 1 ? "s" : "")} found (the profile does not tick SDH by itself)");
            }

            if (commentary > 0)
            {
                parts.Add($"{commentary} commentary track{(commentary > 1 ? "s" : "")} guessed and ticked");
            }

            return parts.Count == 0 ? "" : "; " + string.Join(", ", parts);
        }
    }

    private async Task Copy()
    {
        var (copied, skipped) = CopyToOthers!(Plan);
        _note = copied == 0 && skipped == 0
            ? $"No other {Others} are ticked."
            : $"Copied to {copied} other {Others}." + (skipped > 0 ? $" {skipped} have other streams and stay as they were." : "");
        await Changed.InvokeAsync();
    }

    public void Dispose() => _timer?.Dispose();
}

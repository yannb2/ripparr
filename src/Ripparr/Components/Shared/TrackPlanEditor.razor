@* The tracks of a job: keep, language, flags, name and order (drag the grip, or the arrows). Changes go straight into the plan. *@

<div class="table-responsive">
    <table class="table table-sm align-middle mb-0 small">
        <thead>
        <tr>
            <th title="Keep">Keep</th>
            <th>Track</th>
            <th>From the disc</th>
            @if (Probe != null)
            {
                <th class="text-end text-nowrap" title="@(Probe.Estimated ? "Estimated from the start of the film" : "Counted in samples spread over the whole film")">Bit rate</th>
                <th class="text-end">Size</th>
            }
            <th style="width: 9rem">Language</th>
            <th title="Default track">Default</th>
            <th>Flags</th>
            <th title="Fills {description} in the profile's track name template (added in brackets when the template has none). Start with = to type the whole name.">Description</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var track in Plan.Tracks)
        {
            <tr class="@(track.Keep ? "" : "text-body-secondary") @(DropHere(track) ? "sv-drop-target" : "")"
                @ondragenter="() => _over = track" @ondragover:preventDefault="@(_dragging != null)" @ondrop="() => Drop(track)">
                <td><input type="checkbox" class="form-check-input" @bind="track.Keep"/></td>
                <td class="text-nowrap">
                    @if (track.DolbyVisionLayer)
                    {
                        <span class="badge sv-dv">DV layer</span>
                    }
                    else
                    {
                        @track.Kind
                    }
                </td>
                <td class="text-nowrap">
                    @Codec(track)
                    @if (!string.IsNullOrEmpty(track.Details))
                    {
                        <span class="text-body-secondary">@(" · " + track.Details)</span>
                    }
                    @if (!string.IsNullOrEmpty(track.DiscLanguage))
                    {
                        <span class="text-body-secondary">@(" · " + Languages.Name(track.DiscLanguage))</span>
                    }
                    <span class="text-body-secondary" title="@($"0x{track.Pid:X4}")">@($" · PID {track.Pid}")</span>
                    @if (track.Kind == StreamKind.Audio && ListenUrl != null && !track.DolbyVisionLayer)
                    {
                        <button class="btn btn-sm btn-link p-0 ms-1" title="Listen to 20 seconds of this track" @onclick="() => Listen(track)">
                            <i class="bi @(_listening == track.Pid ? "bi-volume-up-fill" : "bi-volume-up")"></i>
                        </button>
                    }
                    @if (track.Unsure)
                    {
                        <span class="badge text-bg-warning ms-1" title="A stereo track after the multichannel one in the same language: a commentary or an audio description. The disc does not say which; listen to it.">Commentary or AD?</span>
                        <button class="btn btn-sm btn-outline-secondary py-0 px-1 ms-1" @onclick="() => track.Commentary = true">Commentary</button>
                        <button class="btn btn-sm btn-outline-secondary py-0 px-1 ms-1" @onclick="() => track.VisualImpaired = true">AD</button>
                    }
                    @if (track.Kind == StreamKind.Subtitle && Subtitles is { Running: false, Error: null } regionScan
                         && regionScan.Tracks.TryGetValue(track.Pid, out var region) && region.Region != null)
                    {
                        <button class="badge border-0 ms-1 @(region.Region == "CA" ? "text-bg-info" : "text-bg-secondary")"
                                title="@($"Words that point there: {region.RegionEvidence}. Click to set the language.")"
                                @onclick="() => SetRegion(track, region.Region)">
                            @(region.Region == "CA" ? "Looks like Québec French" : "Looks like France French")
                        </button>
                    }
                    @if (_listening == track.Pid)
                    {
                        <div class="mt-1"><audio controls autoplay preload="none" src="@ListenUrl!(track)" style="height: 2rem; max-width: 22rem"></audio></div>
                    }
                    @if (track.Kind == StreamKind.Subtitle && Subtitles is { Running: false, Error: null } scan && scan.Tracks.TryGetValue(track.Pid, out var read))
                    {
                        <a class="ms-1" href="discs/@scan.Key/subtitles/@track.Pid" target="_blank" title="Preview the captions (new tab)"><i class="bi bi-eye"></i></a>
                        @if (Compare != null)
                        {
                            <label class="form-check form-check-inline mb-0 ms-1 me-0 small text-nowrap" title="Tick two or more tracks, then Side by side lines their captions up by time">
                                <input type="checkbox" class="form-check-input" checked="@Compare.Contains(track.Pid)"
                                       @onchange="e => CompareChanged.InvokeAsync((track.Pid, e.Value is true))"/>
                                <i class="bi bi-layout-three-columns"></i> compare
                            </label>
                        }
                        @if (read.Sdh)
                        {
                            <span class="badge text-bg-info ms-1" title="@read.Reason">SDH found</span>
                        }
                        @if (read.Commentary)
                        {
                            <span class="badge text-bg-warning ms-1" title="@read.Reason">commentary?</span>
                        }
                        @if (!read.Sdh && !read.Commentary && read.Reason != null)
                        {
                            <i class="bi bi-info-circle text-body-secondary ms-1" title="@read.Reason"></i>
                        }
                    }
                </td>
                @if (Probe != null)
                {
                    var probed = Probe.Streams.GetValueOrDefault(track.Pid);
                    <td class="text-end text-nowrap text-body-secondary">@(probed is { BitRate: > 0 } ? Approx + Format.BitRate(probed.BitRate) : "")</td>
                    <td class="text-end text-nowrap text-body-secondary">@(probed is { Size: > 0 } ? Approx + Format.Size(probed.Size) : "")</td>
                }
                <td>
                    @if (!track.DolbyVisionLayer)
                    {
                        <input class="form-control form-control-sm" @bind="track.Language" title="ISO 639-2 code, such as eng or fre; or an IETF tag such as fr-CA"/>
                        <div class="small text-body-secondary text-truncate">@Languages.Name(track.Language)</div>
                        @if (Languages.IsFrench(track.Language))
                        {
                            <div class="small text-nowrap">
                                <button class="btn btn-link btn-sm p-0 @(Languages.Region(track.Language) == "CA" ? "text-body-secondary" : "fw-semibold")"
                                        title="French (fre)" @onclick="@(() => track.Language = "fre")">France</button>
                                <span class="text-body-secondary">·</span>
                                <button class="btn btn-link btn-sm p-0 @(Languages.Region(track.Language) == "CA" ? "fw-semibold" : "text-body-secondary")"
                                        title="French (Canada): fr-CA in the MKV" @onclick="@(() => track.Language = "fr-CA")">Québec</button>
                            </div>
                        }
                    }
                </td>
                <td>
                    @if (!track.DolbyVisionLayer)
                    {
                        <input type="checkbox" class="form-check-input" checked="@track.Default" @onchange="e => SetDefault(track, e)"/>
                    }
                </td>
                <td class="text-nowrap">
                    @if (track.Kind == StreamKind.Subtitle)
                    {
                        <FlagToggle Icon="@TrackFlags.ForcedIcon" Label="Forced" Tip="Forced subtitles: only the foreign lines" @bind-Value="track.Forced"/>
                        <FlagToggle Icon="@TrackFlags.SdhIcon" Label="SDH" Tip="For the deaf and hard of hearing (the OCR also marks it when it finds SDH text)" @bind-Value="track.HearingImpaired"/>
                    }
                    @if (track.Kind is StreamKind.Audio or StreamKind.Subtitle && !track.DolbyVisionLayer)
                    {
                        <FlagToggle Icon="@TrackFlags.CommentaryIcon" Label="Comm." Tip="Commentary" @bind-Value="track.Commentary"/>
                    }
                    @if (track.Kind == StreamKind.Audio)
                    {
                        <FlagToggle Icon="@TrackFlags.AdIcon" Label="AD" Tip="Audio description for the visually impaired" @bind-Value="track.VisualImpaired"/>
                    }
                </td>
                <td>
                    @if (!track.DolbyVisionLayer)
                    {
                        <input class="form-control form-control-sm" style="min-width: 9rem" placeholder="{description}" title="Fills {description} in the profile's name template; =Name types the whole name" @bind="track.Name"/>
                    }
                </td>
                <td class="text-nowrap">
                    @if (!track.DolbyVisionLayer)
                    {
                        <span class="sv-grip me-1" draggable="true" title="Drag to move (within its kind)"
                              @ondragstart="() => _dragging = track" @ondragend="EndDrag"><i class="bi bi-grip-vertical"></i></span>
                        <button class="btn btn-sm btn-link p-0 me-1" title="Up" @onclick="() => Plan.Move(track, -1)"><i class="bi bi-arrow-up"></i></button>
                        <button class="btn btn-sm btn-link p-0" title="Down" @onclick="() => Plan.Move(track, 1)"><i class="bi bi-arrow-down"></i></button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    private PlannedTrack? _dragging;
    private PlannedTrack? _over;

    /// <summary>The row under the dragged track, when it can go there (same kind).</summary>
    private bool DropHere(PlannedTrack track) =>
        _dragging != null && _over == track && track != _dragging && track.Kind == _dragging.Kind && !track.DolbyVisionLayer;

    private void Drop(PlannedTrack target)
    {
        if (_dragging != null)
        {
            Plan.MoveTo(_dragging, target);
        }

        EndDrag();
    }

    private void EndDrag()
    {
        _dragging = null;
        _over = null;
    }

    [Parameter, EditorRequired] public TrackPlan Plan { get; set; } = new();

    /// <summary>The quick read of the playlist's streams, when there is one.</summary>
    [Parameter] public ProbeResult? Probe { get; set; }

    /// <summary>The full read of the subtitle tracks, when there is one: caption counts and a preview.</summary>
    [Parameter] public SubtitleScan? Subtitles { get; set; }

    /// <summary>The subtitle tracks ticked for Side by side, when the subtitles were read.</summary>
    [Parameter] public IReadOnlySet<int>? Compare { get; set; }

    [Parameter] public EventCallback<(int Pid, bool On)> CompareChanged { get; set; }

    /// <summary>The address of a short sample of an audio track, when the disc can be read for one.</summary>
    [Parameter] public Func<PlannedTrack, string>? ListenUrl { get; set; }

    private int? _listening;

    private static void SetRegion(PlannedTrack track, string? region) => track.Language = region == "CA" ? "fr-CA" : "fre";

    private void Listen(PlannedTrack track) => _listening = _listening == track.Pid ? null : track.Pid;

    private string Approx => Probe?.Estimated == true ? "≈ " : "";

    /// <summary>The codec as the stream says it once read (TrueHD Atmos 7.1), else as the playlist says it.</summary>
    private string Codec(PlannedTrack track)
    {
        var facts = Probe?.Streams.GetValueOrDefault(track.Pid)?.Facts;
        return facts == null || string.IsNullOrEmpty(facts.Format)
            ? $"{track.Codec} {track.Layout}".Trim()
            : track.Kind switch
            {
                StreamKind.Audio => $"{facts.AudioCodec} {facts.ChannelWords}".Trim(),
                StreamKind.Video => facts.VideoCodec,
                _ => track.Codec
            };
    }

    private void SetDefault(PlannedTrack track, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            Plan.SetDefault(track);
        }
        else
        {
            track.Default = false;
        }
    }
}

@* A TV disc: the series from Sonarr, then one job per episode playlist, numbered from the first episode. *@
@inject SonarrClient Sonarr
@inject JobStore Store
@inject JobRunner Runner
@inject NavigationManager Navigation
@inject MenuReader Menus

<div class="card mb-3">
    <div class="card-header fw-semibold">TV episodes: @SelectedCount of @Shown.Count() playlists</div>
    <div class="card-body">
        <div class="row g-2 align-items-end mb-3">
            <div class="col-md-6">
                <label class="form-label small mb-1">Look up in Sonarr</label>
                <div class="input-group input-group-sm">
                    <input class="form-control" @bind="_search" @onkeyup="SearchOnEnter"/>
                    <button class="btn btn-outline-secondary" @onclick="Search" disabled="@(!Sonarr.Configured || _searching)">
                        @if (_searching)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <i class="bi bi-search"></i>
                        }
                    </button>
                </div>
                @if (!Sonarr.Configured)
                {
                    <div class="form-text">Sonarr is not set up: fill in the series, year and IDs by hand, and type the episode titles.</div>
                }
            </div>
            <div class="col-md-6">
                <label class="form-label small mb-1">Profile</label>
                <select class="form-select form-select-sm" value="@_profileId" @onchange="ChangeProfile">
                    @foreach (var profile in Profiles)
                    {
                        <option value="@profile.Id">@profile.Name</option>
                    }
                </select>
            </div>
        </div>

        @if (_searchError != null)
        {
            <div class="alert alert-warning py-2 small">@_searchError</div>
        }

        @if (_picked != null)
        {
            <div class="small text-body-secondary mb-2"><i class="bi bi-check2-circle me-1"></i>@_picked</div>
        }

        @if (_matches.Count > 0)
        {
            <div class="list-group list-group-flush mb-3 small">
                @foreach (var match in _matches.Take(8))
                {
                    <div class="list-group-item list-group-item-action d-flex align-items-center gap-2">
                        <button class="btn btn-link p-0 text-reset text-decoration-none text-start flex-grow-1 small" @onclick="() => Pick(match)">
                            <span class="fw-semibold">@Naming.TitleAndYear(match.Title, match.Year)</span>
                            <span class="text-body-secondary ms-2">TVDB @match.TvdbId · @Languages.Name(match.OriginalLanguage)</span>
                            @if (match.Anime)
                            {
                                <span class="badge text-bg-info ms-2">Anime numbers</span>
                            }
                            @if (match.SonarrId != null)
                            {
                                <span class="badge text-bg-success ms-2">In Sonarr</span>
                            }
                        </button>
                        @if (match.SonarrId == null)
                        {
                            <button class="btn btn-sm btn-outline-secondary py-0 text-nowrap" @onclick="() => _adding = _adding == match ? null : match"
                                    title="Adds the series to Sonarr (unmonitored, no search) for its episode titles and the manual import">
                                <i class="bi bi-plus-lg"></i> Add to Sonarr
                            </button>
                        }
                    </div>
                    @if (_adding == match)
                    {
                        <ArrAddForm App="Sonarr" LoadOptions="Sonarr.AddOptionsAsync" AddIt="(root, profile, anime) => AddToSonarr(match, root, profile, anime)"
                                    Animation="match.Animation" Anime="@(match.Anime || (match.Animation && match.OriginalLanguage == "jpn"))" AskAnime="true"
                                    Cancelled="() => _adding = null"/>
                    }
                }
            </div>
        }

        <div class="row g-2 mb-2">
            <div class="col-md-4">
                <label class="form-label small mb-1">Series</label>
                <input class="form-control form-control-sm" @bind="_title" @bind:event="oninput"/>
            </div>
            <div class="col-md-1">
                <label class="form-label small mb-1">Year</label>
                <input class="form-control form-control-sm" type="number" @bind="_year"/>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">TVDB ID</label>
                <input class="form-control form-control-sm" type="number" @bind="_tvdb"/>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">TMDb ID</label>
                <input class="form-control form-control-sm" type="number" @bind="_tmdb"/>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">IMDb ID</label>
                <input class="form-control form-control-sm" @bind="_imdb"/>
            </div>
            <div class="col-md-1">
                <label class="form-label small mb-1" title="ISO 639-2, such as eng or jpn">Language</label>
                <input class="form-control form-control-sm" value="@_original" @onchange="ChangeOriginal"/>
                <div class="small text-body-secondary text-truncate">@(_original == null ? "" : Languages.Name(_original))</div>
            </div>
        </div>
        <div class="row g-2 mb-2">
            <div class="col-md-3">
                <label class="form-label small mb-1" title="Where the disc came from: who released the ISO (FraMeSToR...), read from its name, or Own disc. Written as the MKV tag SOURCE_RELEASE_GROUP; empty counts as Own disc.">Source group</label>
                <input class="form-control form-control-sm" list="episode-source-groups" placeholder="@Job.OwnDisc" @bind="_sourceGroup" @bind:event="oninput"/>
                <datalist id="episode-source-groups"><option value="@Job.OwnDisc"></option></datalist>
            </div>
            <div class="col-md-1">
                <label class="form-label small mb-1" title="Only when two releases differ by country: three letters, such as GBR. Written as the MKV tag DISC_COUNTRY and as [GBR] after the source in the file names.">Country</label>
                <input class="form-control form-control-sm" list="episode-countries" maxlength="3" placeholder="GBR..." @bind="_country" @bind:event="oninput"/>
                <datalist id="episode-countries">
                    @foreach (var country in ReleaseName.Countries)
                    {
                        <option value="@country"></option>
                    }
                </datalist>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-end gap-3 mb-2">
            <div>
                <label class="form-label small mb-1">Season</label>
                <input class="form-control form-control-sm" type="number" min="0" style="width: 6rem" list="episodes-seasons"
                       @bind="_season" @bind:after="NumbersChanged"/>
            </div>
            <div>
                <label class="form-label small mb-1">First episode on this disc</label>
                <input class="form-control form-control-sm" type="number" min="0" style="width: 8rem" list="@EpisodeList(_season)"
                       @bind="_first" @bind:after="NumbersChanged"/>
            </div>
            @* Sonarr's seasons and episodes to pick from; typing works too. *@
            <datalist id="episodes-seasons">
                @foreach (var season in _episodes.Select(e => e.Season).Distinct().Order())
                {
                    <option value="@season">@(season == 0 ? "Specials" : $"Season {season}")</option>
                }
            </datalist>
            @foreach (var season in _episodes.Select(e => e.Season).Distinct())
            {
                <datalist id="@EpisodeList(season)">
                    @foreach (var episode in _episodes.Where(e => e.Season == season).OrderBy(e => e.Episode))
                    {
                        <option value="@episode.Episode">@episode.Title@(episode.Runtime is { } runtime ? $" ({runtime} min)" : "")</option>
                    }
                </datalist>
            }
            <div class="form-check form-switch mb-1">
                <input class="form-check-input" type="checkbox" id="anime" @bind="_anime"/>
                <label class="form-check-label small" for="anime" title="Sonarr's Anime series type: the absolute number goes in the name, S01E05 (005)">Absolute numbers (anime)</label>
            </div>
            <div class="form-check form-switch mb-1 ms-auto">
                <input class="form-check-input" type="checkbox" id="episodesAll" @bind="_showAll"/>
                <label class="form-check-label small" for="episodesAll">Show all playlists</label>
            </div>
        </div>
        @if (SelectedPlaylists.Count >= 2)
        {
            <div class="small text-body-secondary mb-2 d-flex flex-wrap align-items-center gap-2">
                <span>
                    <i class="bi bi-sort-numeric-down"></i>
                    @if (Matched)
                    {
                        @State.MatchNote
                    }
                    else
                    {
                        <text>Numbered @OrderNote.</text>
                        @if (_readingMenu)
                        {
                            <text> Reading the disc menu for its order…</text>
                        }
                        else if (Analysis.MenuOrder == null && Analysis.MenuNote != null)
                        {
                            <text> @Analysis.MenuNote</text>
                        }
                        @if (State.MatchNote != null)
                        {
                            <text> @State.MatchNote</text>
                        }
                    }
                    @(Analysis.IsDvd ? "Check the order on the DVD's menu or in MakeMKV" : "Check with Watch (the start shows the title)") and change a number if it is wrong.
                </span>
                @if (_episodes.Count > 0)
                {
                    <button class="btn btn-sm btn-link p-0" @onclick="() => UseRunningTimes(true)"
                            title="Give each playlist the next episode (or a special of this season) whose running time in Sonarr fits it best">
                        <i class="bi bi-stopwatch"></i> Match running times
                    </button>
                }
                @if (Matched)
                {
                    <button class="btn btn-sm btn-link p-0" @onclick="() => UseRunningTimes(false)" title="Number the episodes in disc order again">
                        <i class="bi bi-arrow-counterclockwise"></i> Disc order
                    </button>
                }
            </div>
        }
        @if (State.Disagreement is { } disagreement && !State.DisagreementHidden && disagreement.Key == MatchKey)
        {
            <div class="alert alert-warning py-2 small">
                <div class="fw-semibold mb-1">
                    <i class="bi bi-exclamation-triangle me-1"></i>@(disagreement.Source switch
                    {
                        DiscOrderSource.PlayAll => "The disc's \"play all\" order",
                        DiscOrderSource.MenuButtons => "The disc menu's order",
                        _ => "The Java menu's order"
                    }) and Sonarr's running times don't agree.
                    @(Matched ? "Numbered by running times for now." : "Numbered in the disc's order for now.")
                </div>
                <table class="table table-sm table-borderless small mb-1 w-auto" style="--bs-table-bg: transparent">
                    <thead>
                    <tr><th>Playlist</th><th>Disc order</th><th>Running times</th></tr>
                    </thead>
                    <tbody>
                    @for (var i = 0; i < disagreement.Disc.Count; i++)
                    {
                        var differs = disagreement.Differs(i);
                        <tr class="@(differs ? "fw-semibold" : "text-body-secondary")">
                            <td>@disagreement.Disc[i].Playlist.Label (@Format.Duration(disagreement.Disc[i].Playlist.Duration))</td>
                            <td>@EpisodeMatcher.Describe(disagreement.Disc[i].Episode)</td>
                            <td>@EpisodeMatcher.Describe(disagreement.RunningTimes[i].Episode)</td>
                        </tr>
                    }
                    </tbody>
                </table>
                <ul class="mb-2 ps-3">
                    @foreach (var suggestion in disagreement.Suggestions)
                    {
                        <li>@suggestion</li>
                    }
                </ul>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    @if (Matched)
                    {
                        <button class="btn btn-sm btn-light border" @onclick="() => UseRunningTimes(false)"><i class="bi bi-list-ol"></i> Use the disc's order</button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-light border" @onclick="() => UseRunningTimes(true)"><i class="bi bi-stopwatch"></i> Use running times</button>
                    }
                    <button class="btn btn-sm btn-link p-0" @onclick="() => State.DisagreementHidden = true">Hide</button>
                </div>
            </div>
        }
        @if (_resumeNote != null)
        {
            <div class="small text-body-secondary mb-2"><i class="bi bi-bookmark me-1"></i>@_resumeNote</div>
        }
        @if (_episodesNote != null)
        {
            <div class="small text-body-secondary mb-2"><i class="bi bi-info-circle me-1"></i>@_episodesNote</div>
        }
        @if (LongTitle is { } longTitle && !_rows.Any(r => r.Value.Selected && DvdDisc.ParsePart(r.Key)?.Title == longTitle.Playlist.Name))
        {
            <div class="alert alert-info py-2 small d-flex flex-wrap align-items-center gap-2">
                <span>
                    <i class="bi bi-collection-play me-1"></i>@longTitle.Playlist.Label (@Format.Duration(longTitle.Playlist.Duration), @longTitle.Playlist.Mpls.Chapters.Count chapters)
                    looks like @longTitle.Episodes episodes in a row, as many TV DVDs play them.
                </span>
                <button class="btn btn-sm btn-light border" @onclick="() => SplitEvenly(longTitle.Playlist, longTitle.Episodes)">
                    <i class="bi bi-scissors"></i> Split it into @longTitle.Episodes episodes by chapters
                </button>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-sm small align-middle mb-2">
                <thead>
                <tr>
                    <th></th>
                    <th>@(Analysis.IsDvd ? "Title" : "Playlist")</th>
                    <th>Length</th>
                    <th class="text-end">Chapters</th>
                    <th class="text-end">Size</th>
                    <th style="width: 10rem">Episode</th>
                    <th style="min-width: 16rem">Title</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var playlist in Shown)
                {
                    var row = Row(playlist);
                    var number = Number(playlist);
                    var known = number is { } n ? Known(SeasonOf(playlist), n) : null;
                    <tr class="@(row.Selected ? "table-active" : "")">
                        <td><input type="checkbox" class="form-check-input" checked="@row.Selected" @onchange="e => row.Selected = e.Value is true"/></td>
                        <td class="fw-semibold text-nowrap">
                            @playlist.Label
                            @if (playlist.PlayAll)
                            {
                                <span class="badge text-bg-warning ms-1">Play all</span>
                            }
                        </td>
                        <td class="text-nowrap">@Format.Duration(playlist.Duration)</td>
                        <td class="text-end">@playlist.Mpls.Chapters.Count</td>
                        <td class="text-end text-nowrap">@Format.Size(playlist.Size)</td>
                        <td>
                            @if (row.Selected)
                            {
                                <div class="input-group input-group-sm flex-nowrap">
                                    <span class="input-group-text" title="@(row.Season == 0 ? "A special (season 0 in Sonarr)" : null)">@($"S{SeasonOf(playlist):00}E")</span>
                                    @* A fixed width: the number (and its picker arrow) stays readable beside the x of a special. *@
                                    <input class="form-control" type="number" min="0" style="min-width: 4.5rem" value="@row.Number" placeholder="@number" list="@EpisodeList(SeasonOf(playlist))"
                                           @onchange="e => { row.Number = int.TryParse(e.Value?.ToString(), out var v) ? v : null; row.Matched = false; }"/>
                                    @if (row.Season is { } other)
                                    {
                                        <button class="btn btn-outline-secondary" title="@($"Back to season {_season}")" @onclick="() => row.Season = null"><i class="bi bi-x"></i></button>
                                    }
                                </div>
                            }
                        </td>
                        <td>
                            @if (row.Selected)
                            {
                                <input class="form-control form-control-sm" placeholder="episode title"
                                       value="@(row.Title.Length > 0 ? row.Title : known?.Title)"
                                       @onchange="e => SetTitle(row, e, known)"/>
                                @if (known != null)
                                {
                                    var facts = new List<string>();
                                    if (row.Title.Length == 0 && known.Title.Length > 0)
                                    {
                                        facts.Add("from Sonarr");
                                    }
                                    else if (known.Title.Length > 0 && row.Title != known.Title)
                                    {
                                        facts.Add($"Sonarr: {known.Title}");
                                    }

                                    if (known.Runtime is { } runtime)
                                    {
                                        facts.Add($"{runtime} min");
                                    }

                                    if (known.AirDate is { } aired)
                                    {
                                        facts.Add($"aired {aired:d MMM yyyy}");
                                    }

                                    @if (facts.Count > 0)
                                    {
                                        <div class="text-body-secondary">@string.Join(" · ", facts)</div>
                                    }
                                    @* The episode's summary, to tell the playlists apart (Watch, Tracks); it follows the number. *@
                                    @if (known.Overview is { } overview)
                                    {
                                        <div class="small text-body-secondary episode-overview" tabindex="0" title="@overview">@overview</div>
                                    }
                                }
                                @if (_anime && known?.Absolute is { } absolute)
                                {
                                    <div class="text-body-secondary">absolute @EpisodeNumbers.Absolute(absolute)</div>
                                }
                            }
                        </td>
                        <td>
                            @if (!Analysis.IsDvd)
                            {
                                <button class="btn btn-sm btn-link p-0 me-2 text-nowrap" @onclick="() => row.Pictures = !row.Pictures"
                                        title="Three pictures from the playlist, to check the order">
                                    <i class="bi @(row.Pictures ? "bi-images" : "bi-image")"></i> Pictures
                                </button>
                            }
                            <button class="btn btn-sm btn-link p-0 text-nowrap" @onclick="() => row.Tracks = !row.Tracks"
                                    title="This episode's audio and subtitle tracks: untick what you don't want">
                                <i class="bi @(row.Tracks ? "bi-music-note-list" : "bi-music-note")"></i> Tracks
                            </button>
                            @if (!Analysis.IsDvd)
                            {
                                <button class="btn btn-sm btn-link p-0 ms-2 text-nowrap" @onclick="() => row.Watch = !row.Watch"
                                        title="30 seconds of the playlist as a small video: start, middle or end">
                                    <i class="bi @(row.Watch ? "bi-play-circle-fill" : "bi-play-circle")"></i> Watch
                                </button>
                            }
                            else if (playlist.PartOf == null && playlist.Mpls.Chapters.Count >= 2)
                            {
                                <button class="btn btn-sm btn-link p-0 ms-2 text-nowrap" @onclick="() => OpenSplit(playlist)"
                                        title="This title plays several episodes in a row: cut it into episodes at chapters">
                                    <i class="bi bi-scissors"></i> Split
                                </button>
                            }
                        </td>
                    </tr>
                    @if (row.Split && playlist.PartOf == null)
                    {
                        var starts = DvdDisc.ParseStarts(row.SplitStarts, playlist.Mpls.Chapters.Count);
                        var lengths = DvdDisc.Lengths(playlist.Mpls.Chapters, playlist.Duration, starts);
                        <tr>
                            <td></td>
                            <td colspan="7">
                                <div class="border rounded p-2 bg-body-tertiary">
                                    <div class="d-flex flex-wrap align-items-end gap-3 mb-2">
                                        <div>
                                            <label class="form-label small mb-1">Episodes in this title</label>
                                            <div class="input-group input-group-sm" style="width: 11rem">
                                                <input class="form-control" type="number" min="1" max="@playlist.Mpls.Chapters.Count" value="@row.SplitEpisodes"
                                                       @onchange="e => SetSplitEpisodes(playlist, row, e)"/>
                                                <button class="btn btn-outline-secondary" title="Spread them evenly: the chapters nearest to each even share of the length"
                                                        @onclick="() => SetSplitEpisodes(playlist, row, null)">Even</button>
                                            </div>
                                        </div>
                                        <div class="flex-grow-1">
                                            <label class="form-label small mb-1">Episodes start at chapters</label>
                                            <input class="form-control form-control-sm" placeholder="1, 7, 13" @bind="row.SplitStarts" @bind:event="oninput"/>
                                        </div>
                                        <div>
                                            <button class="btn btn-sm btn-primary" disabled="@(starts.Count < 2)" @onclick="() => ApplySplit(playlist, row)">
                                                <i class="bi bi-scissors"></i> Make @starts.Count episodes
                                            </button>
                                        </div>
                                    </div>
                                    <div class="small text-body-secondary mb-1">
                                        Parts: @string.Join(" · ", DvdDisc.Ranges(starts, playlist.Mpls.Chapters.Count).Select((r, i) =>
                                            $"ch. {r.From}-{r.To} ({Format.Duration(lengths[i])})"))
                                    </div>
                                    <div class="d-flex flex-wrap gap-1 small">
                                        @for (var c = 0; c < playlist.Mpls.Chapters.Count; c++)
                                        {
                                            var chapter = c + 1;
                                            var end = c + 1 < playlist.Mpls.Chapters.Count ? playlist.Mpls.Chapters[c + 1].Start : playlist.Duration;
                                            var length = end - playlist.Mpls.Chapters[c].Start;
                                            <button class="btn btn-sm py-0 @(starts.Contains(chapter) ? "btn-secondary" : "btn-outline-secondary")"
                                                    title="@($"Chapter {chapter} starts at {Format.Duration(playlist.Mpls.Chapters[c].Start)} and runs {Format.Duration(length)}. Click: an episode starts here, or not.")"
                                                    disabled="@(chapter == 1)" @onclick="() => ToggleStart(row, chapter, playlist.Mpls.Chapters.Count)">
                                                @chapter <span class="opacity-75">@Format.Duration(length)</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (row.Tracks)
                    {
                        <tr>
                            <td></td>
                            <td colspan="7">
                                <PlaylistTracks Source="Source" Analysis="Analysis" Playlist="playlist" Plan="PlanFor(playlist)" State="row.Subtitles" DetectSdh="@(Profile.DetectSdh)" CanListen="CanListen"
                                                CopyToOthers="plan => CopyToOthers(playlist, plan)" Reset="() => row.Plan = null" Changed="StateHasChanged"/>
                            </td>
                        </tr>
                    }
                    @if (row.Watch)
                    {
                        <tr>
                            <td></td>
                            <td colspan="7"><WatchPanel SourcePath="@Source.Path" Playlist="@playlist.Name"/></td>
                        </tr>
                    }
                    @if (row.Pictures)
                    {
                        <tr>
                            <td></td>
                            <td colspan="7">
                                <div class="d-flex flex-wrap gap-2 py-1">
                                    @for (var i = 0; i < Thumbnails.Count; i++)
                                    {
                                        <img src="@PictureUrl(playlist, i)" alt="Picture @(i + 1) of playlist @playlist.Name" loading="lazy"
                                             class="rounded border bg-body-tertiary" style="height: 120px; min-width: 160px; object-fit: contain"
                                             onerror="this.replaceWith(Object.assign(document.createElement('span'), {className: 'small text-body-secondary align-self-center', textContent: 'No picture (too big to stream out of the ISO without the mount service, or ffmpeg could not read it)'}))"/>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        @if (Preview is { } preview)
        {
            <div class="small mb-2">
                <div><span class="text-body-secondary">First MKV title:</span> <span class="fw-semibold">@preview.Title</span></div>
                <div><span class="text-body-secondary">First file (codec and HDR words come from the streams):</span> <span class="sv-path">@preview.Folder/@preview.File</span></div>
            </div>
        }

        @if (_error != null)
        {
            <div class="alert alert-danger py-2 small">@_error</div>
        }

        <div class="d-flex gap-2">
            <button class="btn btn-primary" disabled="@(SelectedCount == 0)" @onclick="() => Queue(false)">
                <i class="bi bi-play-fill"></i> Queue @SelectedCount episode@(SelectedCount == 1 ? "" : "s")
            </button>
            <button class="btn btn-outline-secondary" disabled="@(SelectedCount == 0)" @onclick="() => Queue(true)">Dry run</button>
            <span class="ms-auto align-self-center @(Analysis.IsDvd ? "d-none" : "")">
                <BulkSubtitleCheck Source="Source" Analysis="Analysis" DetectSdh="Profile.DetectSdh" Changed="StateHasChanged"
                                   Items="() => SelectedPlaylists.Select(p => (p, PlanFor(p), Row(p).Subtitles)).ToList()"/>
            </span>
        </div>
    </div>
</div>

<ExtrasPicker Source="Source" Analysis="Analysis" Profiles="Profiles" Taken="Taken" Season="_season" Tv="true" FilmJob="SeriesJob" CanListen="CanListen" State="State.Extras"/>

@code {
    [Parameter, EditorRequired] public DiscSource Source { get; set; } = null!;
    [Parameter, EditorRequired] public DiscAnalysis Analysis { get; set; } = null!;
    [Parameter, EditorRequired] public List<RipProfile> Profiles { get; set; } = [];

    /// <summary>What to look up first: the series name guessed from the disc's name.</summary>
    [Parameter] public string InitialSearch { get; set; } = "";

    /// <summary>ffmpeg can cut a sample: Listen buttons on the episodes' audio tracks.</summary>
    [Parameter] public bool CanListen { get; set; }

    /// <summary>The card as typed: kept in the disc's draft, so leaving the page and coming back finds it.</summary>
    [Parameter] public EpisodesPickerState State { get; set; } = new();

    private Dictionary<string, EpisodeRow> _rows => State.Rows;
    private List<PlaylistInfo> _found = [];
    private EpisodesPickerState? _seen;
    private bool _showAll { get => State.ShowAll; set => State.ShowAll = value; }
    private string _profileId { get => State.ProfileId; set => State.ProfileId = value; }

    private string _search { get => State.Search; set => State.Search = value; }
    private string? _picked { get => State.Picked; set => State.Picked = value; }
    private bool _searching;
    private string? _searchError;
    private List<SeriesMatch> _matches { get => State.Matches; set => State.Matches = value; }
    private List<EpisodeInfo> _episodes { get => State.Known; set => State.Known = value; }
    private string? _episodesNote { get => State.EpisodesNote; set => State.EpisodesNote = value; }
    private string? _resumeNote { get => State.ResumeNote; set => State.ResumeNote = value; }

    private string _title { get => State.Title; set => State.Title = value; }
    private int? _year { get => State.Year; set => State.Year = value; }
    private int? _tvdb { get => State.Tvdb; set => State.Tvdb = value; }
    private int? _tmdb { get => State.Tmdb; set => State.Tmdb = value; }
    private string? _imdb { get => State.Imdb; set => State.Imdb = value; }
    private string? _original { get => State.Original; set => State.Original = value; }
    private string? _sourceGroup { get => State.SourceGroup; set => State.SourceGroup = value; }
    private string? _country { get => State.Country; set => State.Country = value; }
    private bool _anime { get => State.Anime; set => State.Anime = value; }
    private int _season { get => State.Season; set => State.Season = value; }
    private int _first { get => State.First; set => State.First = value; }
    private string? _error;

    private RipProfile Profile => Profiles.FirstOrDefault(p => p.Id == _profileId) ?? Profiles.FirstOrDefault() ?? new RipProfile();

    protected override void OnParametersSet()
    {
        if (_seen == State && _found.Count > 0)
        {
            return;
        }

        _seen = State;
        _found = EpisodeFinder.Find(Analysis);
        if (State.Started)
        {
            // Back on the page: everything typed and ticked is still in the draft.
            return;
        }

        State.Started = true;
        _sourceGroup = ReleaseName.Group(Source.Name) ?? Job.OwnDisc;
        _country = ReleaseName.Country(Source.Name);
        _rows.Clear();
        foreach (var playlist in _found)
        {
            Row(playlist).Selected = true;
        }

        var video = _found.FirstOrDefault()?.Resolution;
        _profileId = video == "2160p"
            ? Profiles.FirstOrDefault(p => p.Id == "uhd-remux")?.Id ?? Profiles.FirstOrDefault()?.Id ?? ""
            : Profiles.FirstOrDefault(p => p.Id == "bd-remux")?.Id ?? Profiles.FirstOrDefault()?.Id ?? "";
        if (_search.Length == 0)
        {
            var guess = ReleaseName.Guess(Source.Name);
            _title = guess.Title;
            _year = guess.Year;
            _search = InitialSearch.Length > 0 ? InitialSearch : guess.Title;
            // The disc's own title is better than a label like DOCTOR_WHO_DISC_01_ECCLESTON_01.
            if (ReleaseName.Season(Analysis.DiscTitle) is var (series, season))
            {
                _title = series;
                _search = series;
                _season = season;
            }
        }
    }

    /// <summary>The episodes found, or every playlist worth a look (not duplicates, a minute or more).</summary>
    private IEnumerable<PlaylistInfo> Shown => _showAll
        ? Ordered(Analysis.Playlists.Where(p => p.PartOf == null && p.DuplicateOf == null && (p.Duration >= TimeSpan.FromMinutes(1) || p.LengthLooksFaked))
            .Concat(SelectedParts).Distinct())
        : Ordered(_found.Concat(_rows.Where(r => r.Value.Selected).Select(r => Analysis.Find(r.Key)).OfType<PlaylistInfo>()).Distinct());

    // The ticked parts of DVD titles (episodes cut out of one long title).
    private IEnumerable<PlaylistInfo> SelectedParts =>
        _rows.Where(r => r.Value.Selected && DvdDisc.ParsePart(r.Key) != null).Select(r => Analysis.Find(r.Key)).OfType<PlaylistInfo>();

    /// <summary>
    /// A DVD with no episode titles of its own but one long title that splits evenly at its
    /// chapters: the card offers to cut it into episodes.
    /// </summary>
    private (PlaylistInfo Playlist, int Episodes)? LongTitle
    {
        get
        {
            if (!Analysis.IsDvd || _found.Count >= 2 || Analysis.MainFeature is not { } main || main.Mpls.Chapters.Count < 2)
            {
                return null;
            }

            var episodes = DvdDisc.GuessEpisodes(main.Mpls.Chapters, main.Duration);
            return episodes >= 2 ? (main, episodes) : null;
        }
    }

    private void OpenSplit(PlaylistInfo playlist)
    {
        var row = Row(playlist);
        row.Split = !row.Split;
        if (row.Split && row.SplitStarts.Length == 0)
        {
            SetSplitEpisodes(playlist, row, null);
        }
    }

    /// <summary>The episodes spread evenly over the chapters: the typed count, or Ripparr's guess.</summary>
    private void SetSplitEpisodes(PlaylistInfo playlist, EpisodeRow row, ChangeEventArgs? e)
    {
        if (e != null)
        {
            row.SplitEpisodes = int.TryParse(e.Value?.ToString(), out var typed) ? Math.Clamp(typed, 1, playlist.Mpls.Chapters.Count) : null;
        }

        var count = row.SplitEpisodes ?? DvdDisc.GuessEpisodes(playlist.Mpls.Chapters, playlist.Duration);
        row.SplitEpisodes = count;
        row.SplitStarts = string.Join(", ", DvdDisc.EvenSplit(playlist.Mpls.Chapters, playlist.Duration, count));
    }

    private static void ToggleStart(EpisodeRow row, int chapter, int chapters)
    {
        var starts = DvdDisc.ParseStarts(row.SplitStarts, chapters);
        if (!starts.Remove(chapter))
        {
            starts.Add(chapter);
        }

        starts = starts.Order().ToList();
        row.SplitStarts = string.Join(", ", starts);
        row.SplitEpisodes = starts.Count;
    }

    private void SplitEvenly(PlaylistInfo playlist, int episodes)
    {
        var row = Row(playlist);
        row.SplitEpisodes = episodes;
        row.SplitStarts = string.Join(", ", DvdDisc.EvenSplit(playlist.Mpls.Chapters, playlist.Duration, episodes));
        ApplySplit(playlist, row);
    }

    /// <summary>The title's episodes become rows of their own, ticked; the whole title is unticked.</summary>
    private void ApplySplit(PlaylistInfo playlist, EpisodeRow row)
    {
        var starts = DvdDisc.ParseStarts(row.SplitStarts, playlist.Mpls.Chapters.Count);
        // Parts of an earlier split of this title go: the new ones replace them.
        foreach (var old in _rows.Where(r => DvdDisc.ParsePart(r.Key)?.Title == playlist.Name).ToList())
        {
            old.Value.Selected = false;
        }

        foreach (var (from, to) in DvdDisc.Ranges(starts, playlist.Mpls.Chapters.Count))
        {
            if (Analysis.Find(DvdDisc.PartName(playlist.Name, from, to)) is { } part)
            {
                var partRow = Row(part);
                partRow.Selected = true;
                partRow.Number = null;
                // Track choices made on the whole title go to its episodes.
                row.Plan?.CopyChoicesTo(PlanFor(part));
            }
        }

        row.Selected = false;
        row.Split = false;
    }

    // Disc order (a "play all" playlist, else clip numbers), so the episode numbers follow it.
    private IEnumerable<PlaylistInfo> Ordered(IEnumerable<PlaylistInfo> playlists) =>
        EpisodeFinder.InDiscOrder(Analysis, playlists.ToList()).Episodes;

    private string OrderNote => EpisodeFinder.InDiscOrder(Analysis, SelectedPlaylists).How;

    private EpisodeRow Row(PlaylistInfo playlist)
    {
        if (!_rows.TryGetValue(playlist.Name, out var row))
        {
            row = new EpisodeRow();
            _rows[playlist.Name] = row;
        }

        return row;
    }

    private List<PlaylistInfo> SelectedPlaylists =>
        Shown.Where(p => Row(p).Selected).ToList();

    private int SelectedCount => SelectedPlaylists.Count;

    private IReadOnlyCollection<string> Taken => _rows.Where(r => r.Value.Selected).Select(r => r.Key).ToHashSet();

    /// <summary>The episode number: typed, or the first episode plus the row's place among the ticked ones.</summary>
    private int? Number(PlaylistInfo playlist)
    {
        var row = Row(playlist);
        if (!row.Selected)
        {
            return null;
        }

        if (row.Number is { } typed)
        {
            return typed;
        }

        return _first + SelectedPlaylists.IndexOf(playlist);
    }

    private EpisodeInfo? Known(int season, int number) => _episodes.FirstOrDefault(e => e.Season == season && e.Episode == number);

    private int SeasonOf(PlaylistInfo playlist) => Row(playlist).Season ?? _season;

    // Matching set the numbers (and the note says how).
    private bool Matched => State.MatchNote != null && SelectedPlaylists.Any(p => Row(p).Number != null);

    /// <summary>
    /// Numbers the ticked playlists by their running time against Sonarr's runtimes (the next
    /// episodes from the first one, or a special of this season); keeps the disc order when the
    /// running times can't tell them apart. When the disc itself gives the order (a "play all"
    /// playlist, the menu's buttons) and the running times disagree, the disc's order stays and a
    /// warning shows both; a Java menu's order is a guess, so there the running times win.
    /// </summary>
    private void MatchRunningTimes()
    {
        var playlists = SelectedPlaylists;
        var (matches, note) = EpisodeMatcher.Find(playlists, _episodes, _season, _first);
        var source = EpisodeFinder.SourceOf(Analysis, playlists);
        var disagreement = EpisodeMatcher.Compare(MatchKey, playlists, matches, _episodes, _season, _first, source);
        if (disagreement?.Key != State.Disagreement?.Key)
        {
            State.DisagreementHidden = false;
        }

        State.Disagreement = disagreement;
        var apply = matches != null && (disagreement == null
            || (State.UseRunningTimes ?? source is not (DiscOrderSource.PlayAll or DiscOrderSource.MenuButtons)));
        if (apply)
        {
            foreach (var match in matches!)
            {
                var row = Row(match.Playlist);
                row.Number = match.Episode.Episode;
                row.Season = match.Episode.Season == _season ? null : match.Episode.Season;
                row.Matched = true;
                row.Title = ""; // Sonarr's title for the new number
            }

            State.MatchNote = note;
        }
        else
        {
            DiscOrder();
            State.MatchNote = matches == null && note.Length > 0 ? note : null;
        }
    }

    /// <summary>The order picked on the warning (or with the buttons): it sticks for this disc.</summary>
    private void UseRunningTimes(bool use)
    {
        State.UseRunningTimes = use;
        if (use)
        {
            MatchRunningTimes();
        }
        else
        {
            DiscOrder();
        }
    }

    private static string EpisodeList(int season) => $"episodes-s{season}";

    // A new season or first episode: numbers nobody typed follow it, matched again when Sonarr's episodes are in.
    private void NumbersChanged()
    {
        _first = Math.Max(_first, 0);
        _season = Math.Max(_season, 0);
        if (Untouched)
        {
            DiscOrder();
            MatchIfUntouched();
        }
    }

    // What a disagreement was found for: the ticked playlists, season and first episode.
    private string MatchKey => $"{_season}:{_first}:" + string.Join(",", SelectedPlaylists.Select(p => p.Name));

    /// <summary>The ticked playlists numbered in disc order from the first episode again.</summary>
    private void DiscOrder()
    {
        foreach (var playlist in SelectedPlaylists)
        {
            Row(playlist).Number = null;
            Row(playlist).Season = null;
            Row(playlist).Matched = false;
        }

        State.MatchNote = null;
    }

    // Once Sonarr's episodes are in: match, unless a number was typed (never overwritten).
    private void MatchIfUntouched()
    {
        if (_episodes.Count > 0 && Untouched)
        {
            MatchRunningTimes();
        }
    }

    // No number typed: every one is the disc order's or came from matching.
    private bool Untouched => SelectedPlaylists.All(p => Row(p).Matched || Row(p).Number == null && Row(p).Season == null);

    private bool _readingMenu;

    /// <summary>
    /// Reads the disc's menu (once) for the order it lists the episodes in, when no "play all"
    /// playlist gives it; numbers set by the disc order or by matching follow the new order.
    /// </summary>
    private async Task ReadMenuAsync()
    {
        var key = string.Join(",", _found.Select(p => p.Name).Order(StringComparer.Ordinal));
        if (Analysis.IsDvd || _found.Count < 2 || _readingMenu || Analysis.MenuReadFor == key || EpisodeFinder.PlayAll(Analysis, _found).Playlist != null)
        {
            return;
        }

        Analysis.MenuReadFor = key;
        _readingMenu = true;
        StateHasChanged();
        try
        {
            await Menus.ReadAsync(Source, Analysis, _found, CancellationToken.None);
        }
        finally
        {
            _readingMenu = false;
        }

        // Numbers from the disc order or from matching follow the menu's order, and are weighed against the running times again.
        if (Analysis.MenuOrder != null && Untouched)
        {
            DiscOrder();
            MatchIfUntouched();
        }

        StateHasChanged();
    }

    private string PictureUrl(PlaylistInfo playlist, int index) =>
        $"api/discs/pictures/{index}.jpg?path={Uri.EscapeDataString(Source.Path)}&playlist={Uri.EscapeDataString(playlist.Name)}";

    /// <summary>
    /// Looks the guessed series up in Sonarr when the disc opens, so the episode titles fill in by
    /// themselves: picked straight away when only one series of that name is in the library (the
    /// matches stay listed to change it), else the matches wait for a click.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ = InvokeAsync(ReadMenuAsync);
        }

        if (State.LookedUp || !Sonarr.Configured || _search.Trim().Length == 0 || _tvdb != null)
        {
            return;
        }

        State.LookedUp = true;
        await Search();
        var mine = _matches.Where(m => m.SonarrId != null && string.Equals(m.Title, _search.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
        if (mine.Count == 1)
        {
            var others = _matches.Where(m => m != mine[0]).ToList();
            await Pick(mine[0]);
            _picked = $"Picked {Naming.TitleAndYear(mine[0].Title, mine[0].Year)}, the only series of that name in Sonarr: pick another below if it is wrong.";
            _matches = others;
        }

        StateHasChanged();
    }

    private async Task SearchOnEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Search();
        }
    }

    private async Task Search()
    {
        _picked = null;
        _searching = true;
        _searchError = null;
        (_matches, _searchError) = await Sonarr.SearchAsync(_search, CancellationToken.None);
        if (_searchError == null && _matches.Count == 0)
        {
            _searchError = "Sonarr found nothing.";
        }

        _searching = false;
    }

    private SeriesMatch? _adding;

    /// <summary>Adds the series to Sonarr, then picks it: its episode titles come once Sonarr's refresh ends.</summary>
    private async Task<string?> AddToSonarr(SeriesMatch match, string root, int profile, bool anime)
    {
        var (added, error) = await Sonarr.AddAsync(match, root, profile, anime, CancellationToken.None);
        if (added == null)
        {
            return error;
        }

        _adding = null;
        await Pick(added);
        StateHasChanged(); // the form is a child: its click does not redraw this card
        // Sonarr fills the episodes in the background: wait for them a little.
        for (var i = 0; i < 10 && _episodes.Count == 0 && added.SonarrId is { } id; i++)
        {
            await Task.Delay(2000);
            (_episodes, _) = await Sonarr.EpisodesAsync(id, CancellationToken.None);
        }

        _episodesNote = _episodes.Count == 0 ? "Added to Sonarr; it has no episodes yet. Search again in a minute." : $"Added to Sonarr in {root}.";
        MatchIfUntouched();
        StateHasChanged();
        return null;
    }

    private async Task Pick(SeriesMatch match)
    {
        _picked = null;
        _title = match.Title;
        _year = match.Year;
        _tvdb = match.TvdbId;
        _tmdb = match.TmdbId;
        _imdb = match.ImdbId;
        _original = match.OriginalLanguage;
        _anime = match.Anime;
        _matches = [];
        _episodes = [];
        _episodesNote = null;
        Resume();
        if (match.SonarrId is { } id)
        {
            string? error;
            (_episodes, error) = await Sonarr.EpisodesAsync(id, CancellationToken.None);
            _episodesNote = error ?? (_episodes.Count == 0 ? "Sonarr has no episodes for this series yet." : null);
            MatchIfUntouched();
        }
        else
        {
            _episodesNote = "Not in Sonarr yet: add it there for the episode titles, or type them.";
        }
    }

    private string ResumeKey => $"tv.next.{(_tvdb is { } tvdb ? tvdb.ToString() : _title.Trim().ToLowerInvariant())}";

    /// <summary>
    /// Starts where the last disc of this series stopped, unless the disc's own title names another
    /// season ("Doctor Who - Season 2 - Disc 1"): then that season, from episode 1 on its first disc.
    /// </summary>
    private void Resume()
    {
        _resumeNote = null;
        var titled = ReleaseName.Season(Analysis.DiscTitle)?.Season;
        var saved = Store.Setting(ResumeKey);
        if (saved?.Split(':') is not [var s, var e] || !int.TryParse(s, out var season) || !int.TryParse(e, out var episode) || season == 0)
        {
            return;
        }

        if (titled is { } named && named != season)
        {
            _season = named;
            if (ReleaseName.DiscNumber(Analysis.DiscTitle) == 1)
            {
                _first = 1;
            }

            _resumeNote = $"Season {named} from the disc's title (the last disc of this series stopped before {EpisodeNumbers.Code(season, episode)}).";
            return;
        }

        _season = season;
        _first = episode;
        _resumeNote = $"The last disc of this series stopped before {EpisodeNumbers.Code(season, episode)}: this one starts there.";
    }

    /// <summary>The episode's tracks as the form stands: the edited plan, or a fresh one from the profile.</summary>
    private TrackPlan PlanFor(PlaylistInfo playlist) =>
        Row(playlist).Plan ??= TrackPlanner.Build(playlist.Mpls, Profile, _original);

    /// <summary>"Same for all episodes": the other ticked episodes take this one's choices, track by track.</summary>
    private (int Copied, int Skipped) CopyToOthers(PlaylistInfo from, TrackPlan plan)
    {
        var (copied, skipped) = (0, 0);
        foreach (var other in SelectedPlaylists.Where(p => p != from))
        {
            if (plan.CopyChoicesTo(PlanFor(other)))
            {
                copied++;
            }
            else
            {
                skipped++;
            }
        }

        return (copied, skipped);
    }

    // Sonarr's title stays "from Sonarr" (it follows a changed number) until another one is typed.
    private static void SetTitle(EpisodeRow row, ChangeEventArgs e, EpisodeInfo? known)
    {
        var typed = e.Value?.ToString()?.Trim() ?? "";
        row.Title = typed == known?.Title ? "" : typed;
    }

    private void ChangeProfile(ChangeEventArgs e) => _profileId = e.Value?.ToString() ?? _profileId;

    private void ChangeOriginal(ChangeEventArgs e)
    {
        var text = e.Value?.ToString()?.Trim();
        _original = string.IsNullOrEmpty(text) ? null : text.ToLowerInvariant();
    }

    /// <summary>The series as a job (title, year, IDs, language, tags): the episodes and the extras start from it.</summary>
    private (Job? Job, string? Error) SeriesJob()
    {
        if (string.IsNullOrWhiteSpace(_title) || _year is null)
        {
            return (null, "A series and a year are needed for the folder name.");
        }

        return (new Job
        {
            SourcePath = Source.Path,
            SourceKind = Source.Kind,
            SourceName = Source.Name,
            Title = _title.Trim(),
            Year = _year,
            TvdbId = _tvdb,
            TmdbId = _tmdb,
            ImdbId = string.IsNullOrWhiteSpace(_imdb) ? null : _imdb.Trim(),
            OriginalLanguage = _original,
            SourceReleaseGroup = Job.SourceGroupOrOwnDisc(_sourceGroup),
            DiscTitle = Analysis.DiscTitle,
            Country = Job.CountryCode(_country),
            Profile = Profile,
            Tags = Profile.CustomTags.Select(t => t.Copy()).ToList()
        }, null);
    }

    private List<Job> Episodes(Job series, bool dryRun)
    {
        var jobs = new List<Job>();
        foreach (var playlist in SelectedPlaylists)
        {
            var number = Number(playlist)!.Value;
            var season = SeasonOf(playlist);
            var known = Known(season, number);
            var row = Row(playlist);
            jobs.Add(new Job
            {
                SourcePath = series.SourcePath,
                SourceKind = series.SourceKind,
                SourceName = series.SourceName,
                Playlist = playlist.Name,
                Dvd = Analysis.IsDvd,
                Title = series.Title,
                Year = series.Year,
                TvdbId = series.TvdbId,
                TmdbId = series.TmdbId,
                ImdbId = series.ImdbId,
                OriginalLanguage = series.OriginalLanguage,
                SourceReleaseGroup = series.SourceReleaseGroup,
                DiscTitle = series.DiscTitle,
                Country = series.Country,
                Season = season,
                Episode = number,
                AbsoluteEpisode = _anime ? known?.Absolute : null,
                EpisodeTitle = row.Title.Trim() is { Length: > 0 } typed ? typed : known?.Title is { Length: > 0 } title ? title : null,
                Profile = series.Profile,
                Plan = row.Plan ?? TrackPlanner.Build(playlist.Mpls, series.Profile, series.OriginalLanguage),
                Tags = series.Tags.Select(t => t.Copy()).ToList(),
                DryRun = dryRun
            });
        }

        return jobs;
    }

    private (string Title, string Folder, string File)? Preview
    {
        get
        {
            var (series, _) = SeriesJob();
            if (series == null || SelectedCount == 0)
            {
                return null;
            }

            var first = Episodes(series, true)[0];
            var values = MuxBuilder.NameValues(first, []);
            var playlist = Analysis.Find(first.Playlist);
            var video = playlist?.Mpls.Streams.FirstOrDefault(s => s.Kind == StreamKind.Video && !s.DolbyVisionEnhancementLayer);
            values["resolution"] = video == null ? null : StreamCoding.Resolution(video.Format);
            values["videocodec"] = video?.CodecName;
            var folder = JobPipeline.DoneFolder("done", first, values);
            return (JobPipeline.MkvTitle(first, values), folder, JobPipeline.FileName(first, values));
        }
    }

    private void Queue(bool dryRun)
    {
        _error = null;
        var (series, error) = SeriesJob();
        if (series == null)
        {
            _error = error;
            return;
        }

        var jobs = Episodes(series, dryRun);
        if (jobs.Select(j => (j.Season, j.Episode)).Distinct().Count() != jobs.Count)
        {
            _error = "Two playlists have the same episode number.";
            return;
        }

        if (jobs.FirstOrDefault(j => !j.Plan.Kept.Any(t => t.Kind == StreamKind.Video)) is { } novideo)
        {
            _error = $"Playlist {novideo.Playlist} has no video track to keep.";
            return;
        }

        foreach (var job in jobs)
        {
            Runner.Enqueue(job);
        }

        if (!dryRun)
        {
            // The next disc starts after this one's last episode of the season (specials aside: season 0 is never resumed).
            if (_season > 0 && jobs.Where(j => j.Season == _season).Max(j => j.Episode) is { } last)
            {
                Store.SetSetting(ResumeKey, $"{_season}:{last + 1}");
            }
        }

        Navigation.NavigateTo(jobs.Count == 1 ? $"job/{jobs[0].Id}" : "queue");
    }
}

<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Version>0.4.20</Version>
        <InvariantGlobalization>false</InvariantGlobalization>
        <!-- The SDK only adds blazor.web.js when it sees .razor files at restore time.
             The Dockerfile restores from the .csproj alone, so say it here. -->
        <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Ripparr.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- Shared with Muxarr: subtitles (PGS, OCR, SDH). A git submodule, see README. -->
        <ProjectReference Include="..\..\arrkit\src\Arrkit\Arrkit.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Jobs, profiles and settings, in /config. -->
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    </ItemGroup>

</Project>
